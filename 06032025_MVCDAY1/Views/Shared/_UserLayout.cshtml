    <script>
                function loadStockAlerts() {
            const threshold = 20;

            fetch('/Orders/GetLowStockNotifications?threshold=' + threshold)
                .then(response => {
                    if (!response.ok) throw new Error("HTTP status " + response.status);
                    return response.json();
                })
                .then(data => {
                   
                    const count = data.length;
                    document.getElementById("lowStockCount").innerText = count;

                    const dropdown = document.getElementById("lowStockList");
                    dropdown.innerHTML = '';

                    if (count === 0) {
                        dropdown.innerHTML = '<li class="text-success text-center">All products are in stock</li>';
                        return;
                    }

                    data.forEach(item => {
                        dropdown.innerHTML += `<li class="dropdown-item">
                            <strong>${item.product_name}</strong><br/>
                            <small>Stock: ${item.quantity_available}</small>
                        </li>`;
                    });
                })
                .catch(error => {
                    console.error("Fetch error:", error);
                    document.getElementById("lowStockList").innerHTML = `<li class="text-danger text-center">Failed to load alerts</li>`;
                });
        }
            document.addEventListener('DOMContentLoaded', function () {
            loadStockAlerts(); 

            
            setInterval(loadStockAlerts, 30000); //30 seconds
        });
    </script>

      
