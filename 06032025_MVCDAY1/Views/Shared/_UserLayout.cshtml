<body>
    <header id="headercolor">
        <nav class="navbar">
            <div class="container-fluid">
                <span class="navbar-brand mb-0 h1">DealBazar</span>
                <form class="d-flex w-50" role="search">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                    <button class="btn btn-outline-success" type="submit">Search</button>
                    
                </form>
                <div>
                    <i class="fa fa-fw fa-user" style='font-size:16px'></i>
                    @* <i class='fas fa-shopping-cart' style='font-size:16px'></i> *@
                   
                </div>
                
            </div>
           
        </nav>
        <nav class="navbar navbar-expand-lg" >
            <div class="container-fluid" >
                <a class="navbar-brand" href="#" ></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon bg-dark"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav" id="navtext">
                        <li class="nav-item">
                            <a class="nav-link" aria-current="page" asp-area="" asp-controller="Vendor" asp-action="Index">Home</a>
                        </li>
                      
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="NewProduct">Add Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="GetProduct"> Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Orders">Manage Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Vendor" asp-action="review">Manage Reviews</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Inventory">Inventory</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Seller" asp-action="SellerHome">Log Out</a>
                        </li>
                       @*  <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Vendor" asp-action="review">Report</a>
                        </li> *@
                        
                      
                    </ul>
                </div>
            </div>
        </nav>
    </header>
   
   
    <div>
        @RenderBody()
    </div>

    <div class="container-fluid sticky-bottom" id="footerText">
       
        <footer class="py-3 my-4">
            <p class="text-end">© 2025 DealBazar </p>
        </footer>
    </div>


