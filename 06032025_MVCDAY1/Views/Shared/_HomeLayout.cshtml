<script>
    $(document).ready(function () {
        fetchCartCount();
    });

    function fetchCartCount() {
        $.ajax({
            url: '/Cart/GetCartQuantity',
            type: 'GET',
            success: function (data) {
                $('#cart-count').text(data);
               
            },
            error: function () {
                $('#cart-count').text('0');
            }
        });
    }
</script>
<script>
    let previousSearches = [];

    $(document).ready(function () {
        // Show suggestions as user types
        $('#searchInput').on('input', function () {
            let query = $(this).val().toLowerCase();
            let matched = [];

            if (query) {
                matched = previousSearches.filter(p => p.toLowerCase().startsWith(query));
            }

            let suggestionBox = $('#suggestionBox');
            suggestionBox.empty();

            if (matched.length > 0) {
                matched.forEach(item => {
                    suggestionBox.append(`<a class="dropdown-item">${item}</a>`);
                });
                suggestionBox.show();
            } else {
                suggestionBox.hide();
            }
        });

        // Fill input on click
        $('#suggestionBox').on('click', '.dropdown-item', function () {
            $('#searchInput').val($(this).text());
            $('#suggestionBox').hide();
            $('#searchForm').submit(); // optional: auto-submit
        });

        // Submit search form
        $('#searchForm').submit(function (e) {
            e.preventDefault();

            let searchTerm = $('#searchInput').val().trim();
            if (searchTerm && !previousSearches.includes(searchTerm)) {
                previousSearches.push(searchTerm);
            }

            $.ajax({
                url: '@Url.Action("SearchProduct", "Product")',
                type: 'GET',
                data: { query: searchTerm },
                success: function (result) {
                    $('#productResults').html(result);
                },
                error: function () {
                    alert("Search failed. Please try again.");
                }
            });

            $('#suggestionBox').hide();
        });

        // Hide suggestion box on blur
        $('#searchInput').blur(function () {
            setTimeout(() => { $('#suggestionBox').hide(); }, 200); // delay to allow click
        });
    });
</script>


 


