@* Views/Shared/_AdminLayout.cshtml *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap/js/bootstrap.min.js" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <style>
        body {
            background-color: #131722;
            color: white;
        }

        .sidebar {
            height: 100vh;
            background-color: #1c1f2e;
        }

            .sidebar a {
                color: white;
                display: block;
                padding: 15px;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #2c3147;
                }

        .card-custom {
            background-color: #1c1f2e;
            border: none;
            border-radius: 10px;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-2 sidebar">
                <h3 class="p-3">Deal Bazar</h3>
                <a href="@Url.Action("Index", "Admin")">Dashboard</a>
                <a href="@Url.Action("Orders", "Admin")">Orders</a>
                <a href="@Url.Action("Products", "Admin")">Products</a>
                <div class="dropdown">
                    <a class="dropdown-toggle d-block px-3 py-2 text-white" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Category
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="categoryDropdown">
                        <li><a class="dropdown-item" href="@Url.Action("GetAllcategory", "Admin")">Manage Categories</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("GetAllsubcategory", "Admin")">Manage Subcategories</a></li>
                    </ul>

                </div>
                <a href="@Url.Action("ProductApproval", "Admin")">ProductApprovals</a>
                <a href="@Url.Action("HomeDashBoard", "DashBoard")">Logout</a>
            </div>
            <div class="col-10 p-4">
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>
