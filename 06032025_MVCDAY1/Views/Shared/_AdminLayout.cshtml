@* Views/Shared/_AdminLayout.cshtml *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap/js/bootstrap.min.js" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <link  rel="stylesheet" href="~/css/admin.css"/>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark d-md-none">
        <button class="btn btn-outline-light" id="sidebarToggle">
            <span class="navbar-toggler-icon"></span>
        </button>
        <span class="navbar-brand ms-3">Deal Bazar Admin</span>
    </nav>
   
    <div class="container-fluid">
        <div class="row">
            <div class="col-2 sidebar" id="sidebar">
                <h3 class="p-3">Deal Bazar</h3>
                <a href="@Url.Action("Index", "Admin")">Dashboard</a>
                <a href="@Url.Action("Orders", "Admin")">Orders</a>
                <a href="@Url.Action("Products", "Admin")">Products</a>
                <a href="@Url.Action("PayOut", "Admin")">PayOut</a>
                
                <div class="dropdown">
                    <a class="dropdown-toggle d-block px-3 py-2 text-white" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Category
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="categoryDropdown">
                        <li><a class="dropdown-item" href="@Url.Action("GetAllcategory", "Admin")">Manage Categories</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("GetAllsubcategory", "Admin")">Manage Subcategories</a></li>
                    </ul>

                </div>
                <a href="@Url.Action("ProductApproval", "Admin")">ProductApprovals</a>

                <a href="@Url.Action("PaymentHistory", "Admin")">Payment History</a>
                <a href="@Url.Action("OrderReport", "Admin")">Reports</a>
                <a href="@Url.Action("HomeDashBoard", "DashBoard")">Logout</a>
            </div>
            <div class="col-10 p-4" id="mainContent">
                @RenderBody()
            </div>
        </div>
    </div>
</body>


</html>
<script>
        $(document).ready(function() {
        $('#sidebarToggle').on('click', function () {
            $('#sidebar').toggleClass('show');
        });
    });
</script>
