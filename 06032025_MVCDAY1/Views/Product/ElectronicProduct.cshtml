<div class="container-fluid d-inline-block">
    <div class="d-inline-flex">
        <div>
            <input type="checkbox" id="menu-togglemobilefilter">
            <label for="menu-togglemobilefilter" class="overlay"></label>

            <!-- ====== NAVBAR (New) ====== -->
            <div class="navbar">
                <label for="menu-togglemobilefilter" class="open-btn">☰</label>
            </div>


            <div class="filtersidebar">
                <label for="menu-togglemobilefilter" class="close-btn">&times;</label>
                @{
                    Html.RenderPartial("~/Views/Product/ElectronicFilter.cshtml");
                }
            </div>
        </div>
        <div>
            <div class="container-fluid mt-5">
                <h2 class="text-center mb-4">BuY IT</h2>
                <div class="row">
                    <!-- Samsung -->
                    <div class="col-md-3">
                        <div class="card product-card">
                            <label class="wishlist-label">
                                <input type="checkbox" class="wishlist-checkbox">
                                <svg class="heart-icon" viewBox="0 0 24 24">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                                </svg>
                            </label>

                            <img src="~/image/electronic/boat.webp" width="200" height="250" class="card-img-top" alt="Product Image" id="image">
                            <div class="card-body" class="wishlist-item" id="wishlist-item1">
                                <h5 class="card-title" id="name">boAt</h5>
                                <p class="card-text" id="price">₹ 1400</p>
                                <button class="btn btn-primary buyNowBtn" data-name="samsung s25 ultra" data-price="₹130000" data-image="https://cdn.pixabay.com/photo/2022/03/12/09/23/smartphone-7063762_640.jpg">Buy Now</button>
                                <button class="btn btn-primary cart-btn" onclick="addToCart('Samsung S25 Ultra', 130000, 'https://cdn.pixabay.com/photo/2022/03/12/09/23/smartphone-7063762_640.jpg')" asp-area="" asp-controller="UserBuy" asp-action="AddCart">Add to Cart</button>
                                @* <a asp-area="" asp-controller="Payment" asp-action="PaymentProduct" class="btn btn-primary buyNowBtn">Buy Now</a> *@
                            </div>
                        </div>
                    </div>
