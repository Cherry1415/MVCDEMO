<style>
    .sidebarfilter {
        position: relative;
        top: 0;
        width: 300px;
        height: 100%;
        background: white;
        color: black;
        overflow-y: auto;
        z-index: 500;
        transition: 0.1s ease-in-out;
        padding-top: 20px;
    }

        .sidebarfilter a:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }

    .sidebarfilter {
        left: 0;
    }

    .menu-toggle {
        font-size: 20px;
        cursor: pointer;
        padding: 15px;
        background: #232f3e;
        color: black;
        display: inline-block;
    }

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s;
        z-index: 900;
    }

    .sidebarfilter a {
        display: block;
        color: black;
        padding: 10px 20px;
        text-decoration: none;
    }

    .color-box {
        width: 20px;
        height: 20px;
        display: inline-block;
        margin-right: 10px;
        cursor: pointer;
        border-radius: 50%;
    }

</style>


