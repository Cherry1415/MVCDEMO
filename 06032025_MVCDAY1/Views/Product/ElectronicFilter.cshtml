<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
<style>
    .sidebarfilter {
        position: relative;
        top: 0;
        width: 300px;
        height: 100%;
        background: white;
        color: black;
        overflow-y: auto;
        z-index: 500;
        transition: 0.1s ease-in-out;
        padding-top: 20px;
    }

        .sidebarfilter a:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }

    .sidebarfilter {
        left: 0;
    }

    .menu-toggle {
        font-size: 20px;
        cursor: pointer;
        padding: 15px;
        background: #232f3e;
        color: black;
        display: inline-block;
    }

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s;
        z-index: 900;
    }

    .sidebarfilter a {
        display: block;
        color: black;
        padding: 10px 20px;
        text-decoration: none;
    }

    .color-box {
        width: 20px;
        height: 20px;
        display: inline-block;
        margin-right: 10px;
        cursor: pointer;
        border-radius: 50%;
    }

</style>


<div class="sidebarfilter">

    <hr />

    <div class="menu">
     

        <h4>Brands</h4>
        <label><input type="checkbox"> boAt</label><br>
        <label><input type="checkbox"> OnePlus </label><br>
        <label><input type="checkbox"> JBL </label><br>
        <label><input type="checkbox"> Sony </label><br>
        <label><input type="checkbox"> Boult </label><br>
        <label><input type="checkbox"> Noise </label><br>
        <label><input type="checkbox"> Samsung </label><br>
        <label><input type="checkbox"> Apple </label><br>
        <a href="#" class="text-danger" id="resetCategory">Reset</a>

        <hr />

        <h4>Specific Use</h4>
        <label><input type="checkbox"> Travel</label><br>
        <label><input type="checkbox"> Entertainment </label><br>
        <label><input type="checkbox"> Gaming </label><br>
        <label><input type="checkbox"> Fitness </label><br>

        <a href="#" class="text-danger" id="resetCategory">Reset</a>

        <hr />

        <h4>MicroPhone</h4>
        <label><input type="checkbox"> With MicroPhone</label><br>
        <label><input type="checkbox"> Without MicroPhone </label><br>
        <a href="#" class="text-danger" id="resetCategory">Reset</a>

        <hr />

        <h4>Shop by Price</h4>

        <div id="price-slider"></div>
        <p class="mt-2">Price: ₹<span id="min-price">0</span> - ₹<span id="max-price">150000</span></p>
        <a href="#" class="text-danger" id="resetPrice">Reset</a>

        <hr />

        <h4>Compatible Devices</h4>
        <label><input type="checkbox"> Cellphones</label><br>
        <label><input type="checkbox"> Laptops </label><br>
        <label><input type="checkbox"> Car Audio </label><br>
        <label><input type="checkbox"> Desktops </label><br>
        <a href="#" class="text-danger" id="resetCategory">Reset</a>
        

        <hr />

        <h4>Included Components</h4>
        <label><input type="checkbox"> Cables</label><br>
        <label><input type="checkbox"> Headband </label><br>
        <label><input type="checkbox"> WireLess charging Case </label><br>
        <label><input type="checkbox"> Ear Cushions  </label><br>
        <a href="#" class="text-danger" id="resetCategory">Reset</a>

    </div>
</div>

<script>
    $(function() {
        // Price Slider for Mobile
        $("#price-slider-mobile").slider({
            range: true,
            min: 0,
            max: 150000,
            values: [0, 150000],
            slide: function(event, ui) {
                $("#min-price-mobile").text(ui.values[0]);
                $("#max-price-mobile").text(ui.values[1]);
            }
        });

        // Price Slider for Desktop
        $("#price-slider").slider({
            range: true,
            min: 0,
            max: 150000,
            values: [0, 150000],
            slide: function(event, ui) {
                $("#min-price").text(ui.values[0]);
                $("#max-price").text(ui.values[1]);
            }
        });

        // Color Box Selection
        $(".color-filter").change(function() {
            const color = $(this).val();
            const colorBox = $(this).siblings(".color-box");
            if ($(this).prop("checked")) {
                colorBox.addClass("selected");
            } else {
                colorBox.removeClass("selected");
            }
        });

        // Reset Filters (Mobile)
        $("#resetCategoryMobile").click(function() {
            $("input[type=checkbox]").prop("checked", false);
        });

        $("#resetPriceMobile").click(function() {
            $("#price-slider-mobile").slider("values", [0, 150000]);
            $("#min-price-mobile").text("0");
            $("#max-price-mobile").text("1,50,000");
        });

        $("#resetColorMobile").click(function() {
            $(".color-filter").prop("checked", false);
            $(".color-box").removeClass("selected");
        });

        // Reset Filters (Desktop)
        $("#resetCategory").click(function() {
            $("input[type=checkbox]").prop("checked", false);
        });

        $("#resetPrice").click(function() {
            $("#price-slider").slider("values", [0, 150000]);
            $("#min-price").text("0");
            $("#max-price").text("1,50,000");
        });

        $("#resetColor").click(function() {
            $(".color-filter").prop("checked", false);
            $(".color-box").removeClass("selected");
        });

        // Mobile Sidebar - Open
        $("#openFilterSidebar").click(function() {
            $("#mobileSidebar").addClass("show");
            $("#overlay").addClass("show");
        });

        // Mobile Sidebar - Close
        $("#closeFilterSidebar").click(function() {
            $("#mobileSidebar").removeClass("show");
            $("#overlay").removeClass("show");
        });

        // Close sidebar when overlay is clicked
        $("#overlay").click(function() {
            $("#mobileSidebar").removeClass("show");
            $(this).removeClass("show");
        });
    });
</script>