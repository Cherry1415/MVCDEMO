<script>
    $(function() {
        // Price Slider for Mobile
        $("#price-slider-mobile").slider({
            range: true,
            min: 0,
            max: 150000,
            values: [0, 150000],
            slide: function(event, ui) {
                $("#min-price-mobile").text(ui.values[0]);
                $("#max-price-mobile").text(ui.values[1]);
            }
        });

        // Price Slider for Desktop
        $("#price-slider").slider({
            range: true,
            min: 0,
            max: 150000,
            values: [0, 150000],
            slide: function(event, ui) {
                $("#min-price").text(ui.values[0]);
                $("#max-price").text(ui.values[1]);
            }
        });

        // Color Box Selection
        $(".color-filter").change(function() {
            const color = $(this).val();
            const colorBox = $(this).siblings(".color-box");
            if ($(this).prop("checked")) {
                colorBox.addClass("selected");
            } else {
                colorBox.removeClass("selected");
            }
        });

        // Reset Filters (Mobile)
        $("#resetCategoryMobile").click(function() {
            $("input[type=checkbox]").prop("checked", false);
        });

        $("#resetPriceMobile").click(function() {
            $("#price-slider-mobile").slider("values", [0, 150000]);
            $("#min-price-mobile").text("0");
            $("#max-price-mobile").text("1,50,000");
        });

        $("#resetColorMobile").click(function() {
            $(".color-filter").prop("checked", false);
            $(".color-box").removeClass("selected");
        });

        // Reset Filters (Desktop)
        $("#resetCategory").click(function() {
            $("input[type=checkbox]").prop("checked", false);
        });

        $("#resetPrice").click(function() {
            $("#price-slider").slider("values", [0, 150000]);
            $("#min-price").text("0");
            $("#max-price").text("1,50,000");
        });

        $("#resetColor").click(function() {
            $(".color-filter").prop("checked", false);
            $(".color-box").removeClass("selected");
        });

        // Mobile Sidebar - Open
        $("#openFilterSidebar").click(function() {
            $("#mobileSidebar").addClass("show");
            $("#overlay").addClass("show");
        });

        // Mobile Sidebar - Close
        $("#closeFilterSidebar").click(function() {
            $("#mobileSidebar").removeClass("show");
            $("#overlay").removeClass("show");
        });

        // Close sidebar when overlay is clicked
        $("#overlay").click(function() {
            $("#mobileSidebar").removeClass("show");
            $(this).removeClass("show");
        });
    });
</script>