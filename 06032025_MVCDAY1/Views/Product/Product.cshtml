<style>
    .sidebarfilter {
        position: relative;
        top: 0;
        width: 250px;
        height: 100%;
        background: #232f3e;
        color: white;
        overflow-y: auto;
        z-index: 500;
        transition: 0.1s ease-in-out;
        padding-top: 20px;
    }

        .sidebarfilter a:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }

    .sidebarfilter {
        left: 0;
    }

    .menu-toggle {
        font-size: 20px;
        cursor: pointer;
        padding: 15px;
        background: #232f3e;
        color: white;
        display: inline-block;
    }
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s;
        z-index: 900;
    }

    .sidebarfilter a {
        display: block;
        color: white;
        padding: 10px 20px;
        text-decoration: none;
    }

</style>


