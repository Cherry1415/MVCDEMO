@model List<_06032025_MVCDAY1.Models.Product>
@{
    Layout = "_UserLayout";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
        color: #212529;
    }

    .card-white {
        background-color: #ffffff;
        border-radius: 16px;
        border: 1px solid #e0e0e0;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-white:hover {
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
            transform: scale(1.015);
        }

    .card-img-top {
        height: 220px;
        object-fit: contain;
        border-radius: 16px 16px 0 0;
        padding: 10px;
        background-color: #f1f1f1;
    }

    .card-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #343a40;
    }

    .product-attr {
        background-color: #f1f3f5;
        border-radius: 10px;
        padding: 10px;
        font-size: 0.87rem;
        margin-top: 10px;
    }

    .card-footer .btn {
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .btn-success {
        background: linear-gradient(to right, #4ade80, #16a34a);
        color: white;
        border: none;
    }

    .btn-danger {
        background: linear-gradient(to right, #f87171, #dc2626);
        color: white;
        border: none;
    }

        .btn-success:hover, .btn-danger:hover {
            opacity: 0.95;
            transform: scale(1.03);
        }

    h2 {
        font-weight: bold;
        text-align: center;
        margin-bottom: 30px;
        color: #212529;
    }
</style>

<div class="container-fluid mt-4">
    <h2>🛍️ Pending Product Approvals</h2>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            var attr = product.Prod_Attributes.FirstOrDefault();
            var img = product.ProductImages.FirstOrDefault();

            <div class="col-md-6 col-lg-4">
                <div class="card card-white h-100">
                    <img src="~/uploads/@(img?.imgName ?? "no-image.png")" class="card-img-top" alt="Product Image" />

                    <div class="card-body">
                        <h5 class="card-title">@product.product_name</h5>
                        <p><i class="bi bi-cash-coin"></i> ₹@product.price.ToString("N2")</p>
                        <p><i class="bi bi-person-badge"></i> Vendor ID: @product.vendor_id</p>
                        <p><i class="bi bi-tags"></i> Category: @product.category_name</p>
                        <p><i class="bi bi-grid-3x3-gap-fill"></i> Subcategory: @product.subcat_name</p>
                        <p><i class="bi bi-award-fill"></i> Brand: @product.brand_name</p>

                        @if (attr != null)
                        {
                            <div class="product-attr text-dark small">
                                <p><strong>Color:</strong> @attr.color</p>
                                <p><strong>Material:</strong> @attr.material</p>
                                <p><strong>Capacity:</strong> @attr.capacity GB(for powerbank in mAh)</p>
                                <p><strong>Display:</strong> @attr.display cm</p>
                                <p><strong>Processor:</strong> @attr.processor</p>
                                <p><strong>Size:</strong> @attr.size</p>
                                <p><strong>Weight:</strong> @attr.weight gm</p>
                                <p><strong>Gender:</strong> @attr.gender</p>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mt-2">No attribute info available.</p>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>
