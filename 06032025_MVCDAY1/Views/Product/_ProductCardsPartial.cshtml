@model List<_06032025_MVCDAY1.Models.Product>

@{
    int userid = Convert.ToInt32(Context.Session.GetString("user_id"));

}
<script>
    function toggleWishlistIcon(button) {
        var isLoggedIn = '@Context.Session.GetString("email")' !== '';

        if (!isLoggedIn) {
            alert("Please log in to add items to your wishlist.");
            return false; // Stop further execution
        }
        const icon = button.querySelector('.heart-icon');
        icon.classList.toggle('filled');
        icon.classList.toggle('empty');
        // allow the form to submit silently
    }
</script>
<script>
    function toggleWishlist(button, productId) {
        var isLoggedIn = '@Context.Session.GetString("email")' !== '';

        if (!isLoggedIn) {
            alert("Please log in to add items to your wishlist.");
            return false; // Stop further execution
        }

        var heartIcon = button.querySelector(".heart-icon");

        // Send request via hidden iframe
        var form = button.closest("form");
        form.submit();

        // Toggle the icon color immediately
        var currentColor = heartIcon.style.fill;
        heartIcon.style.fill = (currentColor === "red") ? "white" : "red";

        // Save wishlist state in sessionStorage (to persist color on page reload)
        let wishlist = JSON.parse(sessionStorage.getItem("wishlist")) || [];
        if (heartIcon.style.fill === "red") {
            if (!wishlist.includes(productId)) wishlist.push(productId);
        } else {
            wishlist = wishlist.filter(id => id !== productId);
        }
        sessionStorage.setItem("wishlist", JSON.stringify(wishlist));

        return false; // Prevent default form submission
    }

    // Restore wishlist colors on page load
    document.addEventListener("DOMContentLoaded", function () {
        let wishlist = JSON.parse(sessionStorage.getItem("wishlist")) || [];
        document.querySelectorAll(".heart-icon").forEach(icon => {
            let productId = parseInt(icon.closest("button").querySelector("input[name='productId']").value);
            if (wishlist.includes(productId)) {
                icon.style.fill = "red";
            }
        });
    });
</script>
<style>
    .heart-icon.filled {
        fill: red;
    }

    .heart-icon.empty {
        fill: white;
    }
</style>
