<style>
    .modal-content {
        border-radius: 10px;
    }


    /* #imgdiv { */
    /*     position: relative; */
    /* } */

    .col-8.modal-body {
        position: relative;
        top: 20px; /* Adjust this value as needed */
        z-index: 10; /* Ensure the sticky column stays above other content */
        /* height:60%; */
    }

    /* Optional: Add a bit of padding and box-shadow to make the sticky column stand out */
    .col-8.modal-body {
        padding-top: 20px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .quick-view-btn {
        display: none; /* Initially hide the button */
        width: 100%;
        background-color: rgba(0, 0, 0, 0.4); /* Transparent background */
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.6); /* Light border */
        padding: 10px 0;
        cursor: pointer;
        border-radius: 5px;
        font-size: 14px;
        transition: background-color 0.3s, border-color 0.3s;
    }

    .product-card:hover .quick-view-btn {
        display: block; /* Show the button on hover */
    }

    .quick-view-btn:hover {
        background-color: rgba(0, 0, 0, 0.7); /* Darker background on hover */
        border-color: rgba(255, 255, 255, 1);
    }

    .small-images img {
        width: 80px;
        height: 130px;
        object-fit: cover;
        cursor: pointer;
        margin-bottom: 10px;
    }

    .small-images {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Mobile Sidebar */
    .sidebar-mobile {
        position: fixed;
        top: 0;
        left: -250px;
        width: 250px;
        height: 100%;
        background-color: #f8f9fa;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        padding: 20px;
        transition: left 0.3s ease-in-out;
        z-index: 1050;
    }

        .sidebar-mobile.show {
            left: 0;
        }

    /* Overlay */
    .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

        .overlay.show {
            display: block;
        }

    /* Color Box Selection */
    .color-box {
        width: 20px;
        height: 20px;
        display: inline-block;
        margin-right: 10px;
        cursor: pointer;
        border-radius: 50%;
    }

        .color-box.selected {
            border: 2px solid #000;
        }

    .wishlist-label {
        position: absolute;
        top: 10px;
        right: 10px;
        cursor: pointer;
    }

    .wishlist-checkbox {
        display: none;
    }

    .heart-icon {
        width: 24px;
        height: 24px;
        fill: white;
        stroke: black;
        stroke-width: 2;
        transition: fill 0.3s ease-in-out, stroke 0.3s ease-in-out;
    }

    /* Change heart color when checkbox is checked */
    .wishlist-checkbox:checked + .heart-icon {
        fill: red;
        stroke: red;
    }

    .qty-selector {
        display: flex;
        transform: translateX(-28px);
    }

    .qty-selector__btn--minus {
        transform: translateX(15px);
    }

    .product-quantity .form-input {
        max-width: 44px;
        text-align: center;
    }

    .qty-selector__input {
        border: 0;
        padding-top: 0;
        padding-bottom: 5px;
        padding-left: 0;
        padding-right: 0;
    }

    .qty-selector__btn--add {
        transform: translateX(-15px);
    }

    .qty-selector__btn {
        border: 0;
        background: 0 0;
        height: 44px;
        width: 44px;
    }

    .form-field:not(.swatch-color), .product-form .selector-wrapper {
        margin-bottom: 24px;
    }

</style>

