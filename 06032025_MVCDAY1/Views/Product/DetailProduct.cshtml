<div class="modal fade" id="buyNowModal" tabindex="-1" aria-labelledby="buyNowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Made it larger for address layout -->
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="buyNowModalLabel">Confirm Your Purchase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <!-- Product Info Section -->
                    <div class="col-md-5 text-center border-end">
                        <img id="productImage" src="" width="200" height="200" class="mb-3" alt="Product Image">
                        <h5 id="productName"></h5>
                        <p class="text-success">You are eligible for free shipping.</p>

                        <p>Amount: <strong id="amount"></strong></p>
                        <p>Quantity: <span id="quantityDisplay"></span></p>
                        <p>Total Amount: <strong id="amountInput"></strong></p>

                        <input type="hidden" id="amountInputHidden" />
                        <input type="hidden" id="productIdInput" />
                        <input type="hidden" id="quantityInput" />

                        <p class="text-muted small">Taxes included. Discounts and shipping calculated at checkout.</p>
                    </div>

                    <!-- Address Selection Section -->
                    <div class="col-md-7">
                        <h5>📦 Delivery Address</h5>

                        <!-- Add New Address Card -->
                        <div class="mb-3">
                            <div class="card h-100 text-center border-primary" style="cursor:pointer;" data-bs-toggle="offcanvas" data-bs-target="#addAddressCanvas">
                                <div class="card-body">
                                    <h6 class="card-title">➕ Add New Address</h6>
                                    <p class="card-text text-muted">Click to add a new address</p>
                                </div>
                            </div>
                        </div>

                        @if (Model.Item2 != null && Model.Item2.Any())
                        {
                            foreach (var address in Model.Item2)
                            {
                                <div class="card mb-2 border-secondary address-card">
                                    <div class="card-body p-2">
                                        <h6 class="card-title">@address.Name</h6>
                                        <p class="card-text small">
                                            @address.Street, @address.City - @address.ZipCode<br />
                                            Phone: @address.Phone
                                        </p>
                                        <button type="button" class="btn btn-sm btn-success w-100 select-address-btn" data-address-id="@address.address_id">
                                            Deliver to this address
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No saved addresses found. Please add a new address.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <a class="btn btn-primary" id="proceedBtn">Proceed to Checkout</a>
            </div>

        </div>
    </div>
</div>
<!-- Add Address Canvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="addAddressCanvas" aria-labelledby="addAddressCanvasLabel">
    <div class="offcanvas-header">
        <h5 id="addAddressCanvasLabel">Add New Address</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form method="post" asp-action="AddAddress">
            <div class="mb-3"><label>Name</label><input class="form-control" name="Name" required /></div>
            <div class="mb-3"><label>Street</label><input class="form-control" name="Street" required /></div>
            <div class="mb-3"><label>City</label><input class="form-control" name="City" required /></div>
            <div class="mb-3"><label>Zip Code</label><input class="form-control" name="ZipCode" required /></div>
            <div class="mb-3"><label>Phone</label><input class="form-control" name="Phone" required /></div>
            <button type="submit" class="btn btn-primary w-100">Save Address</button>
        </form>
    </div>
</div>
<script>
    $(document).ready(function () {
        $(".buyNowBtn").click(function () {
            var isLoggedIn = '@Context.Session.GetString("email")' !== '';

        if (!isLoggedIn) {
            alert("Please log in to Buy this Item!!");
            return false; // Stop further execution
        }
            let name = $(this).data("name");
            let price = $(this).data("price");
            let image = $(this).data("image");
            let productId = $(this).data("productid");
            let quantity = parseInt($("#quantity").val());
            let totalAmount = price ;


            $("#productIdInput").val(productId);
            $("#productName").text(name);
            $("#amount").text("₹" + price);
            $("#amountInput").val(totalAmount);
            $("#quantityInput").val(quantity);
            $("#quantityDisplay").text(quantity);
            $("#productImage").attr("src", image);

            $("#buyNowModal").modal("show");
        });
    });
</script>

<script>
    function changeImage(element) {
        document.getElementById("mainImage").src = element.src;
    }

    
    function increaseQty() {
      let qty = document.getElementById("quantity");
      let value = parseInt(qty.value, 10);
      qty.value = value + 1;
    }

    function decreaseQty() {
      let qty = document.getElementById("quantity");
      let value = parseInt(qty.value, 10);
      if (value > 1) {
        qty.value = value - 1;
      }
    }
</script>

<script>
    let selectedAddressId = null;

    document.querySelectorAll(".select-address-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            selectedAddressId = this.dataset.addressId;

            // Remove all highlights
            document.querySelectorAll(".select-address-btn").forEach(b => b.classList.remove("btn-primary"));
            document.querySelectorAll(".address-card").forEach(c => c.classList.remove("selected"));

            // Add highlight to selected
            this.classList.add("btn-primary");
            const card = this.closest(".address-card");
            if (card) {
                card.classList.add("selected");
            }

            console.log("Selected Address ID:", selectedAddressId);
        });
    });

    document.getElementById("proceedBtn").addEventListener("click", function () {
        if (!selectedAddressId || isNaN(parseInt(selectedAddressId))) {
            alert("Please select an address before continuing.");
            return;
        }

        makePayment(parseInt(selectedAddressId));
    });
</script>

