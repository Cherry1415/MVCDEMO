<div id="cartSidebarContainer"></div>
@if (Model?.Item1 != null)
{
    <div class="container">
        @foreach (var product in Model.Item1)
        {
            <div class="row">

                <div class="col-md-6">
                    <input type="hidden" asp-for="@product.product_id"/>
                    <img id="mainImage" class="main-image" src="~/uploads/@product.ProductImages?.FirstOrDefault()?.imgName" alt="Main Product Image">
                    <div class="thumbnail-images d-flex mt-2">
                        @if(product.ProductImages != null && product.ProductImages.Any())
                        {
                            @foreach(var img in product.ProductImages)
                            {
                                <img src="~/uploads/@img.imgName" onclick="changeImage(this)">
                            }
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="row align-content-center justify-content-center align-items-center">
                        <div class="d-flex justify-content-center align-items-center ">
                            <h3>Products Details</h3>
                        </div>
                    </div>
                    <h2 class="fw-bold">@product.product_name</h2>
                    <h5 class="fw-bold">₹@product.price</h5>

                    <div class="quantity-container mt-3">
                        <label for="quantity" class="form-label fw-semibold" >Quantity</label>
                        <div class="d-flex align-items-center gap-2">
                            <button class="circle-btn" type="button" onclick="decreaseQty()">
                                <i class="fas fa-minus"></i>
                            </button>
                            <input type="text" class="form-control text-center" id="quantity" value="1" readonly style="width: 60px;">
                            <button class="circle-btn" type="button" onclick="increaseQty()">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <button class="btn-cart add-to-cart-btn" data-product-id="@product.product_id"
                            data-price="@product.price">
                        Add to Cart
                    </button>
                    <button class="btn-buy buyNowBtn" data-name="@product.product_name" data-productid="@product.product_id" data-price="@product.price"
                      data-image="@Url.Content("~/uploads/" + product.ProductImages?.FirstOrDefault()?.imgName)">
                        Buy it now
                    </button>

                    <div class="mt-4">
                        <h5><strong>About the product</strong></h5>
                        <div style="max-height: 300px; overflow-y: auto; overflow-x:auto; border: 1px solid #ccc; padding: 10px;">
                            <p class="text-success">You are eligible for free shipping.</p>
                            <p class="text-muted small">Taxes included. Discounts and shipping calculated at checkout.</p>
                            @* Repeat info removed for brevity *@
                        </div>
                    </div>
                    


                </div>
                <div class="card mt-4">
                    <div class="card-header">
                        <strong>Customer Reviews</strong>
                    </div>
                    <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                        @if (Model.Item3 != null && Model.Item3.Any())
                        {
                            <div class="row">
                                @foreach (var review in Model.Item3)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100 shadow-sm border-0" style="background: #f9f9f9;">
                                            <div class="card-body py-2 px-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <strong class="text-dark">@review.username</strong>
                                                    <small class="text-muted">@review.CreatedDate.ToString("dd MMM yyyy")</small>
                                                </div>
                                                <div class="mb-2">
                                                    <span style="color: #f4b400; font-size: 16px;">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            @Html.Raw(i <= review.Rating ? "&#9733;" : "&#9734;")
                                                        }
                                                    </span>
                                                </div>
                                                <p class="mb-1 text-secondary" style="font-size: 14px;">@review.Review</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No reviews yet. Be the first to review!</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No Product Found!</p>
}

