        }

    #quantity {
        width: 40px;
        text-align: center;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
       

    .circle-btn {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        border: thin;
        border-color:black;
