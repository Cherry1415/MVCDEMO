    .qty-selector {
    display: flex;
    transform: translateX(-28px);
    }

    .qty-selector__btn--minus {
    transform: translateX(15px);
    }

    .product-quantity .form-input {
    max-width: 44px;
    text-align: center;
    }

    .qty-selector__input {
    border: 0;
    padding-top: 0;
    padding-bottom: 5px;
    padding-left: 0;
    padding-right: 0;
    }

    .qty-selector__btn--add {
    transform: translateX(-15px);
    }

    .qty-selector__btn {
    border: 0;
    background: 0 0;
    height: 44px;
    width: 44px;
    }

    .quantity-container {
        font-family: Arial, sans-serif;
        margin: 20px;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
    }

    .qty-btn {
        width: 30px;
        height: 30px;
        font-size: 20px;
