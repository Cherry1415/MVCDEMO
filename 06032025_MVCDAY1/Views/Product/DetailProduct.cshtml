    }

    .qty-selector__btn--add {
    transform: translateX(-15px);
    }

    .qty-selector__btn {
    border: 0;
    background: 0 0;
    height: 44px;
    width: 44px;
    }

    .quantity-container {
        font-family: Arial, sans-serif;
        margin: 20px;
    }

    .quantity-controls {
        display: flex;
        align-items: center;
    }

    .qty-btn {
        width: 30px;
        height: 30px;
        font-size: 20px;
        background-color: #8dadcf;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        margin: 0 5px;
    }

        .qty-btn:hover {
