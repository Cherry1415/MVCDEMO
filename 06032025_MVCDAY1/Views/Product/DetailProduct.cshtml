    cursor: pointer;
    }

    

    
    .qty-selector {
    display: flex;
    transform: translateX(-28px);
    }

    .qty-selector__btn--minus {
    transform: translateX(15px);
    }

    .product-quantity .form-input {
    max-width: 44px;
    text-align: center;
    }

    .qty-selector__input {
    border: 0;
    padding-top: 0;
    padding-bottom: 5px;
    padding-left: 0;
