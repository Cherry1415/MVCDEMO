<div class="modal fade" id="buyNowModal" tabindex="-1" aria-labelledby="buyNowModalLabel" aria-hidden="true">
    <div class="modal-dialog">

        <div class="modal-content">
            @* <form method="post" asp-action="InitiateOrder"> *@
            <div class="modal-header">

                <h5 class="modal-title" id="buyNowModalLabel">Confirm Your Purchase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="productImage" src="" width="200" height="200" class="mb-3" alt="Product Image">
                <h5 id="productName"></h5>
                <p class="text-success">You are eligible for free shipping.</p>

                <p>Amount: <strong id="amount"></strong></p>
                <input type="hidden" id="amountInput"/>
                <input type="hidden" id="productIdInput" />
                <p>Quantity: <span id="quantityDisplay"></span></p>
                <p>Total Amount: <strong id="amountInput"></strong></p>
                <input type="hidden" id="quantityInput" />
               

                <p class="text-muted small">Taxes included. Discounts and shipping calculated at checkout.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                @* <a class="btn btn-primary" asp-area="" asp-controller="Payment" asp-action="InitiateOrder">Proceed to Checkout</a> *@
                <a class="btn btn-primary" onclick="makePayment()">Proceed to Checkout</a>
            </div>
            @* </form> *@
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $(".buyNowBtn").click(function () {
            var isLoggedIn = '@Context.Session.GetString("email")' !== '';

        if (!isLoggedIn) {
            alert("Please log in to Buy this Item!!");
            return false; // Stop further execution
        }
            let name = $(this).data("name");
            let price = $(this).data("price");
            let image = $(this).data("image");
            let productId = $(this).data("productid");
            let quantity = parseInt($("#quantity").val());
            let totalAmount = price ;

            $("#productIdInput").val(productId);
            $("#productName").text(name);
            $("#amount").text("₹" + price);
            $("#amountInput").val(totalAmount);
            $("#quantityInput").val(quantity);
            $("#quantityDisplay").text(quantity);
            $("#productImage").attr("src", image);

            $("#buyNowModal").modal("show");
        });
    });
</script>
