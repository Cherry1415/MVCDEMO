    width: 80px;
    height: auto;
    cursor: pointer;
    border-radius: 5px;
    margin-right: 5px;
    }

    .addon-container {
    margin-top: 20px;
    }

    

    .btn-cart, .btn-buy {
    width: 100%;
    padding: 12px;
    margin-top: 10px;
    font-size: 16px;
    font-weight: bold;
    border: none;
    }

    .btn-cart {
    background-color: cornflowerblue;
    color: white;
    }

    .btn-buy {
        background-color: cornflowerblue;
    color: white;
    }
