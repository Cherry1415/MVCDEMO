<script>
    $(function() {
        // Price Slider for Mobile
        $("#price-slider-mobile").slider({
            range: true,
            min: 0,
            max: 20000,
            values: [0, 20000],
            slide: function(event, ui) {
                $("#min-price-mobile").text(ui.values[0]);
                $("#max-price-mobile").text(ui.values[1]);
            }
        });

        // Price Slider for Desktop
        $("#price-slider").slider({
            range: true,
            min: 0,
            max: 20000,
            values: [0, 20000],
            slide: function(event, ui) {
                $("#min-price").text(ui.values[0]);
                $("#max-price").text(ui.values[1]);
            }
        });

        // Color Box Selection
        $(".color-filter").change(function() {
            const color = $(this).val();
            const colorBox = $(this).siblings(".color-box");
            if ($(this).prop("checked")) {
                colorBox.addClass("selected");
            } else {
                colorBox.removeClass("selected");
            }
        });

        // Reset Filters (Mobile)
        $("#resetCategoryMobile").click(function() {
            $("input[type=checkbox]").prop("checked", false);
        });

        $("#resetPriceMobile").click(function() {
            $("#price-slider-mobile").slider("values", [0, 20000]);
            $("#min-price-mobile").text("0");
            $("#max-price-mobile").text("20,000");
        });

        $("#resetColorMobile").click(function() {
            $(".color-filter").prop("checked", false);
            $(".color-box").removeClass("selected");
        });

        // Reset Filters (Desktop)
        $("#resetCategory").click(function() {
            $("input[type=checkbox]").prop("checked", false);
        });

        $("#resetPrice").click(function() {
            $("#price-slider").slider("values", [0, 20000]);
            $("#min-price").text("0");
            $("#max-price").text("20,000");
        });

        $("#resetColor").click(function() {
            $(".color-filter").prop("checked", false);
            $(".color-box").removeClass("selected");
        });

        // Mobile Sidebar - Open
        $("#openFilterSidebar").click(function() {
            $("#mobileSidebar").addClass("show");
            $("#overlay").addClass("show");
        });

        // Mobile Sidebar - Close
        $("#closeFilterSidebar").click(function() {
            $("#mobileSidebar").removeClass("show");
            $("#overlay").removeClass("show");
        });

        // Close sidebar when overlay is clicked
        $("#overlay").click(function() {
            $("#mobileSidebar").removeClass("show");
            $(this).removeClass("show");
        });
    });
</script>

<h2>Snake Game</h2>
<canvas id="gameCanvas" width="400" height="400"></canvas>
<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    let snake = [{ x: 10, y: 10 }];
    let direction = "right";
    let food = { x: 5, y: 5 };

    // Function to draw the snake
    function drawSnake() {
        ctx.fillStyle = "green";
        for (const segment of snake) {
            ctx.fillRect(segment.x * 20, segment.y * 20, 20, 20);
        }
    }

    // Function to move the snake
    function moveSnake() {
        let head = { ...snake[0] };

        if (direction === "right") head.x += 1;
        if (direction === "left") head.x -= 1;
        if (direction === "up") head.y -= 1;
        if (direction === "down") head.y += 1;

        snake.unshift(head);

        // Check if the snake eats food
        if (head.x === food.x && head.y === food.y) {
            generateFood();
        } else {
            snake.pop();
        }
    }

    // Function to generate new food position
    function generateFood() {
        food = {
            x: Math.floor(Math.random() * 20),
            y: Math.floor(Math.random() * 20)
        };
    }

    // Function to draw food
    function drawFood() {
        ctx.fillStyle = "red";
        ctx.fillRect(food.x * 20, food.y * 20, 20, 20);
    }

    // Function to update the game state
    function updateGame() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        moveSnake();
        drawFood();
        drawSnake();
    }

    // Handle keyboard input for direction change
    document.addEventListener("keydown", function (event) {
        if (event.key === "ArrowUp" && direction !== "down") direction = "up";
        if (event.key === "ArrowDown" && direction !== "up") direction = "down";
        if (event.key === "ArrowLeft" && direction !== "right") direction = "left";
        if (event.key === "ArrowRight" && direction !== "left") direction = "right";
    });

    // Game loop
    setInterval(updateGame, 200);
</script>