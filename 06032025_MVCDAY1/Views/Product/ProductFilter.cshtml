@model ProductFilterModel
@{
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
<style>
    .sidebarfilter {
        position: relative;
        top: 0;
        width: 300px;
        height: 100%;
        background:white;
        color: black;
        overflow-y: auto;
        z-index: 500;
        transition: 0.1s ease-in-out;
        padding-top: 20px;
    }

        .sidebarfilter a:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }

    .sidebarfilter {
        left: 0;
    }

    .menu-toggle {
        font-size: 20px;
        cursor: pointer;
        padding: 15px;
        background: #232f3e;
        color: black;
        display: inline-block;
    }
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s;
        z-index: 900;
    }

    .sidebarfilter a {
        display: block;
        color: black;
        padding: 10px 20px;
        text-decoration: none;
    }

     .color-box {
            width: 20px;
            height: 20px;
            display: inline-block;
            margin-right: 10px;
            cursor: pointer;
            border-radius: 50%;
        }

</style>


<div class="sidebarfilter">
    <div class="menu">
        <h4>Brands</h4>
        @foreach (var brand in Model.AvailableBrands)
        {
            <label>
                <input type="checkbox" name="Brands" value="@brand"
                @(Model.SelectedBrands?.Contains(brand) == true ? "checked" : "")> @brand
            </label>

            <br>
        }
        <a href="#" class="text-danger" id="resetBrands">Reset</a>

        <hr />

        <h4>Shop by Price</h4>
        <div id="price-slider"></div>
        <p class="mt-2">Price: ₹<span id="min-price">@Model.MinPrice.ToString("0")</span> - ₹<span id="max-price">@Model.MaxPrice.ToString("0")</span></p>
        <input type="hidden" id="selectedMinPrice" name="MinPrice" value="@Model.MinPrice">
        <input type="hidden" id="selectedMaxPrice" name="MaxPrice" value="@Model.MaxPrice">
        <a href="#" class="text-danger" id="resetPrice">Reset</a>
    </div>
</div>

<script>
    $(function() {
        // Initialize price slider with actual database range
        $("#price-slider").slider({
            range: true,
            min: @Model.MinPriceRange,
            max: @Model.MaxPriceRange,
            values: [@Model.MinPrice, @Model.MaxPrice],
            slide: function(event, ui) {
                $("#min-price").text(ui.values[0].toLocaleString());
                $("#max-price").text(ui.values[1].toLocaleString());
                $("#selectedMinPrice").val(ui.values[0]);
                $("#selectedMaxPrice").val(ui.values[1]);
            },
            change: function(event, ui) {
                applyFilters();
            }
        });

        // Brand filter change
        $("input[name='Brands']").change(function() {
            applyFilters();
        });

        // Reset buttons
        $("#resetBrands").click(function(e) {
            e.preventDefault();
            $("input[name='Brands']").prop("checked", false);
            applyFilters();
        });

        $("#resetPrice").click(function(e) {
        e.preventDefault();
        $("#price-slider").slider("values", [@Model.MinPriceRange, @Model.MaxPriceRange]);
        $("#min-price").text(@Model.MinPriceRange.ToString("N0"));
        $("#max-price").text(@Model.MaxPriceRange.ToString("N0"));
        $("#selectedMinPrice").val(@Model.MinPriceRange);
        $("#selectedMaxPrice").val(@Model.MaxPriceRange);
        applyFilters();
    });
    });

            function applyFilters() {
        // Show loading indicator
        $("#productResults").html('<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-3x"></i></div>');

        // Get selected brands
        var selectedBrands = [];
        $("input[name='Brands']:checked").each(function() {
            selectedBrands.push($(this).val());
        });

        // Get price range
        var minPrice = $("#selectedMinPrice").val();
        var maxPrice = $("#selectedMaxPrice").val();

        // Get current category from URL
        var urlParts = window.location.pathname.split('/');
        var categoryname = urlParts[urlParts.length - 2];
        var subcategoryname = urlParts[urlParts.length - 1];

        $.ajax({
            url: '@Url.Action("FilterProducts", "Product")',
            type: 'GET',
            data: {
                categoryname: categoryname,
                subcategoryname: subcategoryname,
                brands: selectedBrands,
                minPrice: minPrice,
                maxPrice: maxPrice
            },
            success: function(result) {
                $("#productResults").html(result);

                // Reinitialize any event handlers for new elements
                $('.add-to-cart-btn').click(function(e) {
                    // Your existing cart add logic
                });
            },
            error: function(xhr, status, error) {
                console.error("Filter error:", error);
                $("#productResults").html('<div class="alert alert-danger">Error loading products</div>');
            }
        });
    }
</script>