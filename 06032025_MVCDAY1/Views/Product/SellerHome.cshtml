@model List<ProductPerformanceModel>
@{
    Layout = "_UserLayout";
    var productNames = Model.Select(x => x.ProductName).ToList();
    var totalOrders = Model.Select(x => x.TotalOrders).ToList();
    var totalRevenue = Model.Select(x => x.TotalRevenue).ToList();
}
@{
    int userid = Convert.ToInt32(Context.Session.GetString("user_id"));
}
<link rel="stylesheet" href="~/css/EcomStyles.css" asp-append-version="true" />
<div class="mt-1">

    <div class="container-fluid box1" id="divLog">

        <div class="container-fluid " id="divLogOuter">
            <div class="container-fluid  justify-content-md-start">
                <h1 class="h1">
                    Become a Seller On Our Site.
                </h1>
            </div>
            <div class="container-fluid  justify-content-md-start">
                <h2>
                    Sell your product with us
                </h2>
            </div>

        </div>
        <div></div>
        <div class="container-fluid  " id="divLogOuter">
            <div>
                <img src="https://m.media-amazon.com/images/G/31/bizzopedia/blog3/Blog_3_Banner.png" id="imgV" />
            </div>
        </div>
    </div>

    <div class="container-lg box2">
        <div class="row border border-primary rounded-3 p-3 shadow-sm">
            <div class="col-12">
                <h2 class="text-center font-weight-bold">How to sell on DealBazar</h2>
            </div>

            <!-- STEP 1 -->
            <div class="col-md-6 d-flex align-items-stretch mb-3">
                <div class="d-flex flex-column w-100">
                    <div class="mb-3">
                        <img src="https://m.media-amazon.com/images/G/31/sellonamazon/experiment/HowSellingonAmazonWorks-Template3-Asset1._CB406684202_._SY200_.png" alt="Step 1" class="img-fluid mx-auto" style="height:150px;">
                    </div>
                    <div>
                        <h3 class="font-weight-bold">STEP 1: Register your account</h3>
                        <p>Register on DealBazar with PAN details and an active bank account</p>
                    </div>
                </div>
            </div>

            <!-- STEP 2 -->
            <div class="col-md-6 d-flex align-items-stretch mb-3">
                <div class="d-flex flex-column w-100">
                    <div class="mb-3">
                        <img src="https://img.freepik.com/free-vector/hand-drawn-international-trade_23-2149166407.jpg" alt="Step 2" class="img-fluid mx-auto" id="imgstep">
                    </div>
                    <div>
                        <h3 class="font-weight-bold">STEP 2: Choose storage & shipping</h3>
                        <p>Choose storage, packaging, and delivery options</p>
                    </div>
                </div>
            </div>

            <!-- STEP 3 -->
            <div class="col-md-6 d-flex align-items-stretch mb-3">
                <div class="d-flex flex-column w-100">
                    <div class="mb-3">
                        <img src="https://m.media-amazon.com/images/G/31/sellonamazon/experiment/HowSellingonAmazonWorks-Template3-Asset2._CB406684202_._SY200_.png" alt="Step 3" class="img-fluid mx-auto" style="height:150px;">
                    </div>
                    <div>
                        <h3 class="font-weight-bold">STEP 3: List your products</h3>
                        <p>List your products by providing product and brand details</p>
                    </div>
                </div>
            </div>

            <!-- STEP 4 -->
            <div class="col-md-6 d-flex align-items-stretch mb-3">
                <div class="d-flex flex-column w-100">
                    <div class="mb-3">
                        <img src="https://m.media-amazon.com/images/G/31/sellonamazon/experiment/WhySellonAmazon-SecurePayment-Option4._SL1280_FMpng_.png" alt="Step 4" class="img-fluid mx-auto" style="height:150px;">
                    </div>
                    <div>
                        <h3 class="font-weight-bold">STEP 4: Complete orders & get paid</h3>
                        <p>Deliver orders to customers on time and get paid within 7 days of delivery</p>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="container p-3 text-sm-center">
        <h1> Why To Become Our Seller </h1>
    </div>
    <div class="container">

        <div class="row row-cols-1 row-cols-md-3 mb-3 text-center">
            <div class="col">
                <div class="card mb-4 rounded-3 shadow-lg">
                    <div class="card-header py-3  border-primary">
                        <h4 class="my-0 fw-normal">Many Customers</h4>
                    </div>
                    <div class="card-body">
                        <h4>this is </h4>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card mb-4 rounded-3 shadow-lg">
                    <div class="card-header py-3  border-primary">
                        <h4 class="my-0 fw-normal">Many Sellers</h4>
                    </div>
                    <div class="card-body">
                        <h4>this is </h4>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card mb-4 rounded-3 shadow-lg ">
                    <div class="card-header py-3 border-primary">
                        <h4 class="my-0 fw-normal">Unbeatable Reach</h4>
                    </div>
                    <div class="card-body">
                        <h4>this is </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
<div class="container mt-4">
    <h3 class="mb-4">📊 Product Performance</h3>
    <canvas id="performanceChart" height="100"></canvas>
</div>
<div class="container mt-5">
    <h3 class="mb-4">📈 Product Performance Report</h3>
    <table class="table table-striped shadow">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Total Orders</th>
                <th>Total Revenue</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.TotalOrders</td>
                    <td>₹@item.TotalRevenue</td>

                </tr>
            }
        </tbody>
    </table>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('performanceChart').getContext('2d');

    const performanceChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(productNames)),
            datasets: [
                {
                    label: 'Total Orders',
                    data: @Html.Raw(Json.Serialize(totalOrders)),
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1,
                    yAxisID: 'y',
                },
                {
                    label: 'Total Revenue',
                    data: @Html.Raw(Json.Serialize(totalRevenue)),
                    type: 'bar',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    borderWidth: 2,
                    yAxisID: 'y1',
                    tension: 0.4,
                }
            ]
        },
        options: {
            responsive: true,
            interaction: {
                mode: 'index',
                intersect: false
            },
            stacked: false,
            plugins: {
                title: {
                    display: true,
                    text: 'Product-wise Orders and Revenue',
                    font: { size: 18 }
                }
            },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    title: {
                        display: true,
                        text: 'Total Orders'
                    }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    title: {
                        display: true,
                        text: 'Total Revenue (₹)'
                    },
                    grid: {
                        drawOnChartArea: false
                    }
                }
            }
        }
    });
</script>