@{
    Layout = null;
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/EcomStyles.css" />

<div class="content container-fluid">
    <div class="container shadow-lg mt-3 mb-3 pt-2">
        <div class="page-header d-flex">
            <button class="bg-transparent"><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-arrow-left" style="font-size:16px ; color:darkslategray;"></i></a></button>

            <h1 class="page-header-title">Manage reviews</h1>
        </div>

        <div class="card">
            <!-- Body -->
            <div class="card-body ">
                <div class="row align-items-center">
                    <div class="col-md-auto mb-3 mb-md-0">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <img class="avatar avatar-xl avatar-4x3" src="@Url.Content("~/image/rating-star-2793.svg")" alt="Image Description" data-hs-theme-appearance="default" style="width:100px;height:100px;">
                            </div>

                            <div class="flex-grow-1 ms-5">
                                <h4 class="display-3 text-dark mb-0">4.84</h4>

                            </div>
                        </div>
                    </div>
                    <!-- End Col -->


                </div>
                <!-- End Row -->
            </div>
            <!-- End Body -->
        </div>
        <!-- End Card -->
        <!-- Card -->

        <div class="card">
            <!-- Header -->
            <div class="card-header card-header-content-md-between">
                <div class="mb-2 mb-md-0 justify-content-center">
                    <form>
                        <!-- Search -->
                        <div class="input-group input-group-merge input-group-flush">
                            <div class="input-group-prepend input-group-text">
                                <i class=" fas fa-search" style="color:lightslategray"></i>
                            </div>
                            <input id="datatableSearch" type="search" class="form-control" placeholder="Search reviews" aria-label="Search reviews">
                        </div>
                        <!-- End Search -->
                    </form>
                </div>
            </div>
        </div>


        <!-- Table -->
        <div class="table-responsive datatable-custom">
            <div id="datatable_wrapper" class="dataTables_wrapper no-footer">
                <div class="dt-buttons">
                    <table class="table w-100">
                        <thead class="thead" style="background-color: #b0c9e4">

                            <tr role="row">
                                <th scope="col" class="table-column-pe-0 sorting_disabled" rowspan="1" colspan="1" aria-label="" style="width: 41.9531px;">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="datatableCheckAll">
                                        <label class="form-check-label" for="datatableCheckAll"></label>
                                    </div>
                                </th>
                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Product: activate to sort column ascending" style="width: 300.734px;">Product</th>
                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Reviewer: activate to sort column ascending" style="width: 269.969px;">Reviewer</th>
                                <th class="sorting_disabled" rowspan="1" colspan="1" aria-label="Review" style="width: 419.656px;">Review</th>
                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Date: activate to sort column ascending" style="width: 204.203px;">Date</th>
                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Status: activate to sort column ascending" style="width: 123.938px;">Status</th>
                                <th class="sorting_disabled" rowspan="1" colspan="1" aria-label="Actions" style="width: 89.547px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr role="row" class="odd">
                                <td class="table-column-pe-0">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="usersDataCheck2">
                                        <label class="form-check-label" for="usersDataCheck2"></label>
                                    </div>
                                </td>
                                <th>
                                    <a class="d-flex align-items-center">
                                        <div class="avatar">
                                            <img class="avatar-img" src="https://m.media-amazon.com/images/G/31/img24/Fashion/AF/BAU/Winterflip/Unrec/ClothingSBC/6._SY530_QL85_FMpng_.png" alt="Image Description" style="width:30px; height:30px">
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <span class="card-title h5 text-dark text-inherit">T-Shirt</span>
                                        </div>
                                    </a>
                                </th>
                                <td>
                                    <a class="d-flex align-items-center">
                                        <div class="avatar avatar-circle">
                                            <img class="avatar-img" src="data:image/jpeg;base64," alt="Image Description" style="height:35px; width:35px">
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <span class="card-title h5 text-inherit">chirag patel <i class="bi-patch-check-fill text-primary" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Verified purchase"></i></span>
                                            <span class="d-block fs-6 text-body">chigi@gmail.com</span>
                                        </div>
                                    </a>
                                </td>
                                <td>
                                    <div class="text-wrap" style="width: 18rem;">
                                        <div class="d-flex gap-1 mb-2">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">

                                        </div>

                                        <h4 class="mb-1">I just love it!</h4>
                                        <p>I bought this t-shirt and I love it!! I wear it all the time and there is no problem with the fit.</p>
                                    </div>
                                </td>
                                <td>March 13, 2025  9:30 </td>
                                <td><span class="badge bg-soft-success text-success ms-2">Published</span></td>
                                <td>
                                    <!-- Unfold -->
                                    <div class="hs-unfold">
                                        <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm rounded-circle" id="settingsDropdown1" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa fa-ellipsis-v"></i>
                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end mt-1" aria-labelledby="settingsDropdown1">


                                            <div class="dropdown-divider"></div>

                                            <span class="dropdown-header">Feedback</span>

                                            <a class="dropdown-item" href="#">
                                                <i class="fas fa-reply dropdown-item-icon" style="font-size:16px;color:lightgray"></i> Reply
                                            </a>
                                        </div>
                                    </div>
                                    <!-- End Unfold -->
                                </td>
                            </tr>

                            <tr role="row" class="odd">
                                <td class="table-column-pe-0">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="usersDataCheck2">
                                        <label class="form-check-label" for="usersDataCheck2"></label>
                                    </div>
                                </td>
                                <th>
                                    <a class="d-flex align-items-center">
                                        <div class="avatar">
                                            <img class="avatar-img" src="https://m.media-amazon.com/images/G/31/img24/Fashion/AF/BAU/Winterflip/Unrec/ClothingSBC/6._SY530_QL85_FMpng_.png" alt="Image Description" style="width:30px; height:30px">
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <span class="card-title h5 text-dark text-inherit">T-Shirt</span>
                                        </div>
                                    </a>
                                </th>
                                <td>
                                    <a class="d-flex align-items-center">
                                        <div class="avatar avatar-circle">
                                            <img class="avatar-img" src="data:image/jpeg;base64," alt="Image Description" style="height:35px; width:35px">
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <span class="card-title h5 text-inherit">riya khadela <i class="bi-patch-check-fill text-primary" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Verified purchase"></i></span>
                                            <span class="d-block fs-6 text-body">riya@gmail.com</span>
                                        </div>
                                    </a>
                                </td>
                                <td>
                                    <div class="text-wrap" style="width: 18rem;">
                                        <div class="d-flex gap-1 mb-2">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">
                                            <img src=" @Url.Content("~/image/star.svg")" alt="Review rating" width="15px">

                                        </div>

                                        <h4 class="mb-1">I just love it!</h4>
                                        <p>I bought this t-shirt and I love it!! I wear it all the time and there is no problem with the fit.</p>
                                    </div>
                                </td>
                                <td>March 13, 2025  2:30 </td>
                                <td><span class="badge bg-soft-success text-success ms-2">Published</span></td>
                                <td>
                                    <!-- Unfold -->
                                    <div class="hs-unfold">
                                        <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm rounded-circle" id="settingsDropdown1" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa fa-ellipsis-v"></i>
                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end mt-1" aria-labelledby="settingsDropdown1">


                                            <div class="dropdown-divider"></div>

                                            <span class="dropdown-header">Feedback</span>

                                            <a class="dropdown-item" href="#">
                                                <i class="fas fa-reply dropdown-item-icon" style="font-size:16px;color:lightgray"></i> Reply
                                            </a>
                                        </div>
                                    </div>
                                    <!-- End Unfold -->
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>


        </div>
    </div>
</div>