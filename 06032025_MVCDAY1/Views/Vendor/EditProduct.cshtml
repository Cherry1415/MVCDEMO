@{
    Layout = "_UserLayout";
}


<h4 style="color:black;font-family: 'Arial Narrow Bold'">General Information</h4>

<form action="EditProduct" method="post">

    <input type="hidden" asp-for="pid" />

    <div class="mb-3">

        <label class="form-label" style="color:black;font-family: 'Arial Narrow Bold'">Product Name</label>
        <input asp-For="pname" class="form-control">

    </div>

    <div class="mb-3">

        <button type="submit">Update</button>

    </div>
</form>
<a href="@Url.Action("GetProduct")" class="btn btn-secondary mt-2">Back to List</a>


