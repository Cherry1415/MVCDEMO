        <div class="container">
            <div class="login-container">

                <h4 class="text-center">Sign-In</h4>
        <form action="/Login/LogInPage" method="post">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email or mobile phone number</label>
                        <input type="email" class="form-control" id="email" name="umail" required>
                       
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Sign-In</button>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="keepSignedIn">
                        <label class="form-check-label" for="keepSignedIn">Keep me signed in</label>
                    </div>
                    <p class="help-link"><a href="#">Forgot password?</a></p>
                </form>
                <hr>
                <p class="register-link">New to DealBazar? <a href="#">Create your DealBazar account</a></p>
            </div>
        </div>

