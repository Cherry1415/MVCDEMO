@model List<_06032025_MVCDAY1.Models.UserOrder>



<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Status</th>
                    <th>Select Supplier</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Model)
                {
                    <form asp-action="AssignSupplier" method="post">
                        <input type="hidden" name="orderId" value="@order.Id" />

                    <tr>
                        <td>@order.Id</td>
                        <td>@order.Customer_name</td>
                        <td>
                            <span class="badge bg-@(
                                    order.Status.ToLower() == "pending" ? "warning" :
                                    order.Status.ToLower() == "assigned" ? "info" : "success"
                                )">
                                    @order.Status
                            </span>
                        </td>
                        <td>
                            <select name="supplierId" class="form-select">
                                <option value="">-- Select Supplier --</option>
                                    @foreach (var s in order.AllSuppliers)
                                    {
                                    <option value="@s.SupplierId">@s.Name</option>
                                    }
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4" class="text-end">
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-in-right"></i> Assign Supplier
                            </button>
                        </td>
                    </tr>
                    </form>
                }
            </tbody>
        </table>
    </div>
</div>
