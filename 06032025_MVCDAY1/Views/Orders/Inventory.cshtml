@{
}
@{
    Layout = null;
}


<head>
    <title>Product Inventory</title>
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap/js/bootstrap.min.js" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/EcomStyles.css" />

    <script href="~/bootstrap/js/bootstrap.bundle.min.js"></script>
</head>
@* <div class="text-center"> *@
@*     <h1>All Product</h1> *@
@* </div> *@

<div class="content container-fluid">

    <div class="container shadow-lg mt-3 mb-3 pt-2 ">

        <div class="mt-3 pt-1 d-flex">
            <div class="text-start pt-2">
                <button class="bg-transparent"><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-arrow-left" style="font-size:16px ; color:darkslategray;"></i></a></button>
            </div>
            <div class=" container page-header ">
                <h1 class="page-header-title">Manage Inventory</h1>
            </div>
        </div>

        <div class="table-responsive border-4">
            <table class="table table-striped table-bordered">
                <thead>

                    <tr>
                        <th scope="col">Preview</th>
                        <th scope="col">Product Title</th>
                        <th scope="col">Inventory Status</th>
                        <th scope="col">Date to ReOrder</th>
                        <th scope="col">Inventory Level</th>
                        <th scope="col">ReOrder Qty </th>
                        <th scope="col">ReOrder Cost</th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row"><img src="~/image/Levis-Logo.png" width="50" height="50" /></th>
                        <td scope="col">T-Shirt</td>
                        <td scope="col">In Stock</td>
                        <td scope="col">12/12/2014</td>
                        <td scope="col">200</td>
                        <td scope="col">300</td>
                        <td scope="col">50000</td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>