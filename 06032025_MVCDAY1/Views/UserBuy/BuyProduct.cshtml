                        <p class="card-text" id="price">₹ 1500000</p>
                        <button class="btn btn-primary buyNowBtn">Buy Now</button>
                    </div>
                </div>
            </div>


            <!-- Product 2 -->
           

            <!-- Product 3 -->
            <div class="col-md-4">
                <div class="card product-card">
                    <a href="#"><i class="fas fa-heart position-absolute top-0 end-0 p-2 text-danger" style="z-index: 1;"></i></a>
                    <img src="https://cdn.pixabay.com/photo/2015/12/14/22/26/mobile-phone-1093358_640.jpg" width="400" height="400" class="card-img-top" alt="Product Image" id="image">
