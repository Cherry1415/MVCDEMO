<div class="container mt-5">
    <h2 class="text-center mb-4">BuY IT</h2>
    <div class="row">
        <!-- Product 1 -->
        <div class="col-md-4">
            <div class="card product-card" style="backdrop-filter:blur(10px)">
                
                    <a href="#"><i class="fas fa-heart position-absolute top-0 end-0 p-2 text-danger" style="z-index: 1;"></i></a>
                    <img src="https://cdn.pixabay.com/photo/2022/10/03/20/01/iphone-13-pro-max-7496758_640.jpg" width="400" height="400" class="card-img-top" alt="Product Image">
                
                <div class="card-body">
                    <h5 class="card-title">Iphone 16Pro Max</h5>
                    <p class="card-text">$99.99</p>
                    <a asp-area="" asp-controller="Payment" asp-action="PaymentProduct" class="btn btn-primary">Buy Now</a>
                </div>
            </div>
        </div>


        <!-- Product 2 -->
        <div class="col-md-4">
            <div class="card product-card">
                <a href="#"><i class="fas fa-heart position-absolute top-0 end-0 p-2 text-danger" style="z-index: 1;"></i></a>
                <img src="https://cdn.pixabay.com/photo/2022/03/12/09/23/smartphone-7063762_640.jpg" width="400" height="400" class="card-img-top" alt="Product Image">
                <div class="card-body">
                    <h5 class="card-title">samsung s25 ultra</h5>
                    <p class="card-text">$79.99</p>
                    <a href="#" class="btn btn-primary">Buy Now</a>
                </div>
            </div>
        </div>

        <!-- Product 3 -->
        <div class="col-md-4">
            <div class="card product-card">
                <a href="#"><i class="fas fa-heart position-absolute top-0 end-0 p-2 text-danger" style="z-index: 1;"></i></a>
                <img src="https://cdn.pixabay.com/photo/2015/12/14/22/26/mobile-phone-1093358_640.jpg" width="400" height="400" class="card-img-top" alt="Product Image">
                <div class="card-body">
                    <h5 class="card-title">NoooKiaa</h5>
                    <p class="card-text">$59.99</p>
                    <a href="#" class="btn btn-primary">Buy Now</a>
                </div>
            </div>
        </div>
    </div>
</div>
