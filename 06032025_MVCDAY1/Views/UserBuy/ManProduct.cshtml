@{
}

<style>
    /* Header - Categories */
    .categories {
        display: flex;
        justify-content: center;
        background: white;
        padding: 10px;
        gap: 20px;
        overflow-x: auto;
        white-space: nowrap;
    }

    .category {
        text-align: center;
    }

        .category img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
        }

        .category p {
            margin-top: 5px;
            font-size: 14px;
        }

    /* Banner Section */
    .banner {
        display: flex;
        align-items: center;
        justify-content: space-around;
        background: #fbe7d4;
        padding: 40px 20px;
        height: 10%;
    }

    .banner-content h2 {
        font-size: 24px;
        color: #333;
    }

    .banner-content h3 {
        font-size: 28px;
        color: #222;
        font-weight: bold;
    }

    .brand-logos {
        display: flex;
        gap: 15px;
        align-items: center;
    }

        .brand-logos img {
            width: 100px;
            height: auto;
        }

    .banner-img {
        width: 30%;
        height: 100%;
        border-radius: 10px;
    }

    /* Product Showcase
        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 20px;
            max-width: 1200px;
            margin: auto;
        }

        .product {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

            .product img {
                width: 100%;
                border-radius: 10px;
            }

            .product p {
                margin-top: 10px;
                font-weight: bold;
            }

</style>

<div class="container-fluid d-inline-block">
    <div class="d-inline-flex">
        @{
            Html.RenderPartial("~/Views/Product/ClothFilter.cshtml");
        }

        <div class="d-inline-block">
            <div class="container-fluid mt-5">

                <!-- Header Section -->
                <header>
                    <div class="categories">
                        <div class="category">
                            <img src="~/image/nikunj.jpg" alt="Premium Selects">
                            <p>Shop now</p>
                        </div>
                        <div class="category">
                            <img src="~/image/akshay2.jpg" alt="Fresh Off the Rack">
                            <p>Shop now</p>
                        </div>

                        <div class="category">
                            <img src="~/image/tshirt.jpg" alt="Under ₹299">
                            <p>Under ₹299</p>
                        </div>
                        <div class="category">
                            <img src="~/image/eyewaer.jpg" alt="Eyewear">
                            <p>Eyewear</p>
                        </div>

                    </div>
                </header>
            </div>
            <div class="d-inline-block w-100">
                <!-- Banner Section -->
                <section class="banner">
                    <div class="banner-content">
                        <h2>Most Loved Brands</h2>
                        <h3>Min. 50% Off</h3>
                        <div class="brand-logos">
                            <img src="~/image/Levis-Logo.png" alt="US Polo">
                            <img src="~/image/logo1.png" alt="Allen Solly">

                        </div>
                    </div>
                    <img src="~/image/offer2.jpg" height="250px" alt="Fashion Banner" class="banner-img">
                </section>
            </div>
        </div>
    </div>
    <br />
    
   
    

    <!-- Product Showcase -->
    <section class="products">
        <div class="product">
            <img src="~/image/prod1.jpg" alt="Shirt">
            <p>Trendy Green Shirt</p>
            <button class="btn btn-primary buyNowBtn" data-name="samsung s25 ultra" data-price="₹130000" data-image="https://cdn.pixabay.com/photo/2022/03/12/09/23/smartphone-7063762_640.jpg">Buy Now</button>
            <button class="btn btn-primary cart-btn" onclick="addToCart('Samsung S25 Ultra', 130000, 'https://cdn.pixabay.com/photo/2022/03/12/09/23/smartphone-7063762_640.jpg')" asp-area="" asp-controller="UserBuy" asp-action="AddCart">Add to Cart</button>
        </div>
        <div class="product">
            <img src="~/image/prod2.jpg" alt="Shirt">
            <p>Casual Yellow Shirt</p>
        </div>
        <div class="product">
            <img src="~/image/prod3.jpg" alt="Jeans">
            <p>Ripped Jeans</p>
        </div>
        <div class="product">
            <img src="~/image/prod4.jpg" alt="Sportswear">
            <p>Sporty Look</p>
        </div>
        <div class="product">
            <img src="~/image/tshirt.jpg" alt="Formal Wear">
            <p>Elegant Formal Wear</p>
        </div>
    </section>
</div>

        </div>
        </div>
 </div>

