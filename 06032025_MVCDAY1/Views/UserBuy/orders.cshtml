    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var orders = ViewBag.details;
    ViewData["PageName"] = "Orders";
}

<head>
    <title>@ViewBag.Title</title>
</head>
<div class="text-center">
    <h1>@ViewData["pageName"]</h1>
</div>


<div class="container shadow">
    <div class="border-2">
        <div class="mt-1 mb-1 pt-3 ps-4 pb-3 shadow">
            <button type="button" class="btn btn-outline-primary">All</button>
            <button type="button" class="btn btn-outline-primary">New</button>
            <button type="button" class="btn btn-outline-primary">Pending</button>
            <button type="button" class="btn btn-outline-primary">Completed</button>
            <button type="button" class="btn btn-outline-primary">Dispatched</button>
            <button type="button" class="btn btn-outline-primary">Canceled</button>
        </div>
        <div class="border-4 bg-black">
            <table class="table">
                <thead>

                    <tr>
                        <th scope="col">Order Id</th>
                        <th scope="col">Order Status</th>
                        <th scope="col">Customer Name</th>
                        <th scope="col">Product Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <th scope="row">@order.oid</th>
                            <td scope="col">@order.o_status</td>
                            <td scope="col">@order.c_name</td>
                            <td scope="col">@order.p_name</td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>
