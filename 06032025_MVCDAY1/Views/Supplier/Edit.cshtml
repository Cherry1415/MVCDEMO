@model _06032025_MVCDAY1.Models.WareHouse

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Warehouse</h1>

<h4>Warehouse Details</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="Supplier" asp-action="Edit"  method="post">
            <input type="hidden" asp-for="warehouse_id" />  <!-- Ensure ID is passed -->

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="warehouse_name" class="control-label"></label>
                <input asp-for="warehouse_name" class="form-control" required />
                <span asp-validation-for="warehouse_name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="phone" class="control-label"></label>
                <input asp-for="phone" class="form-control" required />
                <span asp-validation-for="phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="capacity" class="control-label"></label>
                <input asp-for="capacity" type="number" class="form-control" required />
                <span asp-validation-for="capacity" class="text-danger"></span>
            </div>

            <div class="form-group">
               
                <button type="submit">Save</button>
                @* <a asp-action="Index2" class="btn btn-secondary">Cancel</a> *@
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index2">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
