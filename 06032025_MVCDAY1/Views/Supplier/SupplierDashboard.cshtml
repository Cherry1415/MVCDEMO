@model SupplierDashboard
@{
    ViewBag.Title = "Supplier Dashboard";
    Layout = "_MyLayout1";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .card {
        border-radius: 15px;
        transition: transform 0.2s ease-in-out;
    }

    .card:hover {
        transform: scale(1.02);
    }

    .border-start {
        border-left-width: 5px !important;
    }
</style>

<div class="container mt-4">
    <h2 class="text-primary mb-4 fw-bold">👋 Welcome, Supplier</h2>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card text-white shadow border-0" style="background: linear-gradient(45deg, #17a2b8, #138496);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Total Assigned</h6>
                            <h3 class="fw-bold">@Model.TotalAssigned</h3>
                        </div>
                        <i class="fas fa-tasks fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white shadow border-0" style="background: linear-gradient(45deg, #ffc107, #e0a800);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">In Transit</h6>
                            <h3 class="fw-bold">@Model.InTransit</h3>
                        </div>
                        <i class="fas fa-shipping-fast fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white shadow border-0" style="background: linear-gradient(45deg, #28a745, #218838);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Delivered</h6>
                            <h3 class="fw-bold">@Model.Delivered</h3>
                        </div>
                        <i class="fas fa-box-open fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white shadow border-0" style="background: linear-gradient(45deg, #dc3545, #c82333);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Rejected</h6>
                            <h3 class="fw-bold">@Model.Rejected</h3>
                        </div>
                        <i class="fas fa-times-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
    <h5 class="mt-4 mb-3"><i class="fas fa-truck text-primary me-2"></i>📦 Today's Deliveries</h5>

    <div class="row">
        @if (ViewBag.TodayDeliveries != null && ViewBag.TodayDeliveries.Count > 0)
        {
            foreach (var order in ViewBag.TodayDeliveries)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-start border-4 border-success">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-1">
                                    <i class="fas fa-box text-success me-2"></i>Order #@order.Id
                                </h6>
                                <p class="mb-0 text-muted">
                                    <i class="fas fa-user me-1"></i>@order.Customer_name
                                </p>
                            </div>
                            <span class="badge bg-light text-success border border-success px-3 py-2 fw-bold">
                                <i class="far fa-clock me-1"></i>@order.require_date?.ToString("hh:mm tt")
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-secondary text-center" role="alert">
                    <i class="fas fa-calendar-times me-2"></i>No deliveries scheduled for today.
                </div>
            </div>
        }
    </div>
    <!-- 📊 Chart -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-white fw-semibold">
            📈 Orders in Last 15 Days
        </div>
        <div class="card-body">
            <canvas id="orderChart" height="250"></canvas>
        </div>
    </div>

    <!-- 📝 Recent Orders -->
    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">
            📝 Recent Orders
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>OrderDate</th>
                            <th>RequireDate</th>
                            <th>Status</th>
                            <th>Ship Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.Customer_name</td>
                                <td>@order.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td>@order.require_date?.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    <span class="badge bg-@(
                                        order.Status.ToLower() == "delivered" ? "success" :
                                        order.Status.ToLower() == "pending" ? "warning" : "secondary"
                                    )">@order.Status</span>
                                </td>
                                <td>@order.shipped_status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(Json.Serialize(Model.ChartData.Select(d => d.Date.ToString("dd MMM"))));
    const data = @Html.Raw(Json.Serialize(Model.ChartData.Select(d => d.Count)));

    const ctx = document.getElementById('orderChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Orders',
                data: data,
                backgroundColor: 'rgba(13, 110, 253, 0.7)',
                borderColor: 'rgba(13, 110, 253, 1)',
                borderWidth: 1,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                title: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>
