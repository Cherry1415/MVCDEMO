@model _06032025_MVCDAY1.Models.WareHouse_details

<h2>Warehouse Details</h2>

<table class="table">
    <tr><th>ID</th><td>@Model.warehouse_id</td></tr>
    <tr><th>Name</th><td>@Model.warehouse_name</td></tr>
    <tr><th>Phone</th><td>@Model.phone</td></tr>
    <tr><th>Capacity</th><td>@Model.capacity</td></tr>
    <tr><th>Available Quantity</th><td>@Model.available_quantity</td></tr>
    <tr><th>Supplier ID</th><td>@Model.supplier_id</td></tr>
    <tr><th>Vendor ID</th><td>@Model.vendor_id</td></tr>
    <tr><th>Address ID</th><td>@Model.address_id</td></tr>
</table>
