@model _06032025_MVCDAY1.Models.Employee

<h2>Edit Employee</h2>


<div class="container">
    <div class="payment-container">
        <h3 class="text-center">Registration</h3>
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="id" />
            <div class="mb-3">
                <label class="form-label">FirstName</label>
                <input type="text" class="form-control" id="firstName" name="fname" asp-for="fname"  >
            </div>
            <div class="mb-3">
                <label class="form-label">LastName</label>
                <input type="text" class="form-control" id="lastName" maxlength="16" name="lname" asp-for="lname">
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" id="email"  name="email" asp-for="email" >
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone"  name="phone" asp-for="phone" >

                </div>
                
            </div>
            <button type="submit" class="btn btn-success w-100">Update</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary mt-2">Cancel</a>
        </form>
        
    </div>
</div>