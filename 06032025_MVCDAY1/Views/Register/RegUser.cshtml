@model _06032025_MVCDAY1.Models.Employee;

<div class="container">
    <div class="payment-container">
        <h3 class="text-center">Registration</h3>
        <form id="registerForm" asp-action="RegUser" method="post">
            <div class="mb-3">
                <label class="form-label">FirstName</label>
                <input type="text" class="form-control" id="firstName" name="fname" required>
            </div>
            <div class="mb-3">
                <label class="form-label">LastName</label>
                <input type="text" class="form-control" id="lastName" maxlength="16" name="lname" required>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" id="email" placeholder="xyz@gmail.com" name="email" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone" placeholder="+91 XXXXXXXX" name="phone" required>
                   
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" maxlength="3" name="password" required>
                </div>
            </div>
            <button type="submit" class="btn btn-success w-100">Register</button>
        </form>
        <a href="@Url.Action("Index")" class="btn btn-secondary mt-2">Back to List</a>
    </div>
</div>
