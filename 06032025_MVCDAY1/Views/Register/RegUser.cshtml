@{
}
<div class="container">
    <div class="payment-container">
        <h3 class="text-center">Registration</h3>
        <form id="registerForm">
            <div class="mb-3">
                <label class="form-label">FirstName</label>
                <input type="text" class="form-control" id="firstName" required>
            </div>
            <div class="mb-3">
                <label class="form-label">LastName</label>
                <input type="text" class="form-control" id="lastName" maxlength="16" required>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" id="email" placeholder="MM/YY" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone" placeholder="+91 XXXXXXXX" required>
                   
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" maxlength="3" required>
                </div>
            </div>
            <button type="submit" class="btn btn-success w-100">Register</button>
        </form>
    </div>
</div>
