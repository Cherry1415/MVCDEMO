@model List<WeekSalesViewModel>
@{
    ViewBag.Title = "Admin Payout Dashboard";
    Layout = "_AdminLayout"; // Adjust if needed
    int currentMonth = DateTime.Now.Month;
    var months = new[]
           {
        new { Value = 1, Name = "January" },
        new { Value = 2, Name = "February" },
        new { Value = 3, Name = "March" },
        new { Value = 4, Name = "April" },
        new { Value = 5, Name = "May" },
        new { Value = 6, Name = "June" },
        new { Value = 7, Name = "July" },
        new { Value = 8, Name = "Auguest" },
        new { Value = 9, Name = "September" },
        new { Value = 10, Name = "October" },
        new { Value = 11, Name = "November" },
        new { Value = 12, Name = "December" }
    };
}

<style>
    .dashboard-card {
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        transition: transform 0.2s ease;
        min-height: 150px;
    }

        .dashboard-card:hover {
            transform: scale(1.02);
        }

    .dashboard-icon {
        font-size: 2.5rem;
        opacity: 0.2;
        position: absolute;
        right: 20px;
        bottom: 10px;
    }

    .chart-container {
        background: #fff;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        overflow-x: auto;
    }

    .chart-wrapper {
        position: relative;
        width: 100%;
        height: 300px; /* You can adjust this */
    }

 
</style>

<div class="container py-4">
    <h2 class="mb-4 fw-bold text-primary text-center text-md-start">💸 Admin Payout Dashboard</h2>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4 col-sm-6 col-12">
            <div class="card dashboard-card bg-gradient text-white p-4 bg-primary position-relative h-100">
                <div>
                    <h5 class="fw-bold">Total Sales</h5>
                    <h2 id="totalSalesCard">₹0</h2>
                </div>
                <i class="bi bi-bar-chart-line dashboard-icon"></i>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 col-12">
            <div class="card dashboard-card bg-gradient text-white p-4 bg-success position-relative h-100">
                <div>
                    <h5 class="fw-bold">Overall Payout</h5>
                    <h2 id="payoutCard">₹0</h2>
                </div>
                <i class="bi bi-cash-stack dashboard-icon"></i>
            </div>
        </div>
        <div class="col-md-4 col-sm-12 col-12">
            <div class="card dashboard-card bg-gradient text-dark p-4 bg-warning position-relative h-100">
                <div>
                    <h5 class="fw-bold">Pending Payout</h5>
                    <h2 id="pendingCard">₹0</h2>
                </div>
                <i class="bi bi-hourglass-split dashboard-icon"></i>
            </div>
        </div>
    </div>

    <!-- Month Dropdown -->
    <div class="mb-4">
        <label for="monthSelect" class="form-label fw-semibold">Select Month:</label>
        <select id="monthSelect" class="form-select w-25 w-sm-100">
            @foreach (var month in months)
            {
                if (month.Value == currentMonth)
                {
                    <option value="@month.Value" selected="selected">@month.Name</option>
                }
                else
                {
                    <option value="@month.Value">@month.Name</option>
                }
            }
</select>
    </div>
    <form method="get" action="/Admin/DownloadPayoutPdf">
        <input type="hidden" name="month" id="pdfMonth" value="5" />
        <input type="hidden" name="year" id="pdfYear" value="2025" />
        <button type="submit" class="btn btn-danger mt-3">
            <i class="bi bi-file-earmark-pdf"></i> Download PDF
        </button>
    </form>

    <!-- Chart Container -->
    <div class="chart-container mt-3">
        <h4 class="mb-3 text-secondary">📊 Weekly Sales Summary</h4>
        <div class="chart-wrapper">
            <canvas id="weeklySalesChart"></canvas>
        </div>
    </div>
    <p id="noDataMessage" class="text-danger fw-bold mt-3" style="display:none;">
        🚫 No data available for the selected month.
    </p>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let chart;

    function updateChart(month) {
        const year = new Date().getFullYear();

        $.ajax({
            url: '/Admin/GetWeeklySales',
            type: 'GET',
            data: { month: month, year: year },
                success: function (response) {
        const weeklyData = response.weekly;

        // Update Summary Cards - even if 0
        $('#payoutCard').text(`₹${response.payout.toLocaleString()}`);
        $('#totalSalesCard').text(`₹${response.totalSales.toLocaleString()}`);
        $('#pendingCard').text(`₹${response.pending.toLocaleString()}`);

        if (chart) chart.destroy();

        let labels = [];
        let values = [];

        if (weeklyData.length === 0) {
            // Define default weeks (say 1 to 5)
            labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5'];
            values = [0, 0, 0, 0, 0];
            $('#noDataMessage').hide();
            $('#weeklySalesChart').show();
        } else {
            labels = weeklyData.map(d => `Week ${d.weekNumber}`);
            values = weeklyData.map(d => d.totalSales);
            $('#noDataMessage').hide();
            $('#weeklySalesChart').show();
        }

        const ctx = document.getElementById('weeklySalesChart').getContext('2d');
        chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Sales (₹)',
                    data: values,
                    backgroundColor: 'rgba(0, 123, 255, 0.8)', // blue color bars
                    borderColor: 'rgba(0, 123, 255, 1)',
                    borderWidth: 1,
                    borderRadius: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        labels: {
                            color: '#333',
                            font: { size: 16 }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            color: '#000',
                            font: { size: 14 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            color: '#000',
                            font: { size: 14 },
                            callback: value => '₹' + value
                        }
                    }
                }
            }
        });
    },
            error: function (xhr, status, error) {
                console.error("❌ AJAX error:", error);
            }
        });
    }

    $(document).ready(function () {
        updateChart(parseInt($('#monthSelect').val()));
    });

    $('#monthSelect').on('change', function () {
        updateChart(parseInt($(this).val()));
        const selectedMonth = $(this).val();
        const year = new Date().getFullYear();
        $('#pdfMonth').val(selectedMonth);
        $('#pdfYear').val(year);
    });
</script>

