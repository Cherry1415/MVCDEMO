@model List<Subcategory>
@{
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h2 class="text-white mb-4">Subcategories</h2>

    <button class="btn btn-success mb-3" id="btnAddSubcategory">Add New Subcategory</button>

    <div class="table-responsive">
        <table class="table table-dark table-striped">
            <thead >
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Updated At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="subcategoryTableBody">
                <!-- Populated via AJAX -->
            </tbody>
        </table>
    </div>
</div>

<!-- Subcategory Modal -->
<div class="modal fade text-dark" id="subcategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form id="subcategoryForm" method="post">
            <div class="modal-content text-start">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Subcategory</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="SubCategoryId" name="sub_category_id" />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category ID</label>
                        <input type="number" name="category_id" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>


    <script>
        const modal = new bootstrap.Modal(document.getElementById('subcategoryModal'));

        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString("en-GB");
        }

        function LoadSubcategories() {
            $.get("/Admin/GetAllsubcategory1", function (data) {
                let rows = "";
                data.forEach(sub => {
                    rows += `
                        <tr>
                    <td>${sub.sub_category_id}</td>
                            <td>${sub.name}</td>
                            <td>${sub.description}</td>
                            <td>${sub.category_name}</td>
                            <td>
                                <span class="badge bg-${sub.status === "Active" ? "success" : "danger"}">
                                    ${sub.status}
                                </span>
                            </td>
                            <td>${sub.created_at ? formatDate(sub.created_at) : "-"}</td>
                            <td>${sub.updated_at ? formatDate(sub.updated_at) : "-"}</td>
                            <td>
                                <button class="btn btn-sm btn-primary btnEdit" data-id="${sub.sub_category_id}">Edit</button>
                                <button class="btn btn-sm btn-danger btnDelete" data-id="${sub.sub_category_id}">Delete</button>
                            </td>
                        </tr>
                    `;
                });
                $("#subcategoryTableBody").html(rows);
            });
        }

        $(document).ready(function () {
            LoadSubcategories();

            $("#btnAddSubcategory").click(function () {
                $("#modalTitle").text("Add Subcategory");
                $("#subcategoryForm")[0].reset();
                $("#SubCategoryId").val('');
                modal.show();
            });

            $(document).on("click", ".btnEdit", function () {
                const id = $(this).data("id");
                $.get("/Admin/GetSubCategoryById", { id }, function (sub) {
                    $("#modalTitle").text("Edit Subcategory");
                    $("#SubCategoryId").val(sub.sub_category_id);
                    $("input[name='name']").val(sub.name);
                    $("textarea[name='description']").val(sub.description);
                    $("input[name='category_id']").val(sub.category_id);
                    $("select[name='status']").val(sub.status);
                    modal.show();
                });
            });

            $("#subcategoryForm").submit(function (e) {
                e.preventDefault();
        $.post("/Admin/SaveSubCategory", $(this).serialize(), function () {
                    modal.hide();
                    LoadSubcategories();
                });
            });

            $(document).on("click", ".btnDelete", function () {
                const id = $(this).data("id");
                if (confirm("Are you sure you want to delete this subcategory?")) {
                $.post("/Admin/DeleteSubCategory", { id }, function () {
                        LoadSubcategories();
                    });
                }
            });
        });
    </script>

