<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    
    .modal-content {
        border-radius: 10px;
    }

    .modal-footer {
        background: navy;
        color: white;
        text-align: center;
        border-radius: 0 0 10px 10px;
    }

    .container {
        max-width: 900px;
        margin: auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    /* Address Section */
    .address-section {
        padding: 15px;
        border-bottom: 1px solid #ddd;
    }

        .address-section h2 {
            font-size: 18px;
            margin-bottom: 5px;
        }

        .address-section p {
            font-size: 14px;
            color: #333;
        }

        .address-section a {
            color: #0073e6;
            text-decoration: none;
            font-size: 14px;
        }

            .address-section a:hover {
                text-decoration: underline;
            }

    /* Payment Section */
    .payment-section h2 {
        font-size: 20px;
        margin: 20px 0;
    }

    .payment-box {
        background: #f9f9f9;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
    }

        .payment-box h3 {
            font-size: 16px;
            margin-bottom: 10px;
        }

    .payment-option {
        display: block;
        padding: 10px;
        background: white;
        margin-bottom: 10px;
        border-radius: 5px;
        border: 1px solid #ddd;
        cursor: pointer;
        transition: 0.3s;
    }

        .payment-option input {
            margin-right: 10px;
        }

        .payment-option:hover {
            background: #f1f1f1;
        }

        .payment-option.disabled {
            color: gray;
            cursor: not-allowed;
        }

        .payment-option .note {
            font-size: 12px;
            color: gray;
            margin: 5px 0 0 25px;
        }

        .payment-option .card-type {
            float: right;
            font-weight: bold;
            color: #0073e6;
        }

    .add-code {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

        .add-code input {
            flex: 1;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .add-code button {
            background: #ff9900;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

    /* Order Summary */
    .order-summary {
        background: #E0FFFF;
        padding: 15px;
        margin-top: 20px;
        border-radius: 5px;
        text-align: center;
    }

        .order-summary p {
            font-size: 14px;
            margin: 5px 0;
        }

        .order-summary h3 {
            font-size: 18px;
            margin: 10px 0;
        }

    .order-btn {
        background: #00FFFF;
        color: black;
        padding: 10px;
        border: none;
        width: 100%;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        border-radius: 5px;
        transition: 0.3s;
    }

        .order-btn:hover {
            background:#00BFFF;
        }

    .pay-btn {
        float: right;
        background: #ddd;
        padding: 5px 10px;
        border-radius: 5px;
        border: none;
        cursor: pointer;
    }
</style>
<div class="container">
   
    <!-- Delivery Address Section -->
    <div class="address-section">
        <h2>Delivering to Chirag</h2>
        <p>34, ShantiKunj society, Nr. Palnpur jakatnaka, SURAT, GUJARAT, 395009, India</p>
        <a href="#">Add delivery instructions</a> | <a href="#">Change</a>
    </div>

    <!-- Payment Method Section -->
    <div class="payment-section">
        <h2>Payment Method</h2>

        <div class="payment-box">
            <h3>Your available balance</h3>
            <label class="payment-option">
                <input type="radio" name="payment" disabled>
                DealBazar Pay Balance ₹0.00 Unavailable
                <br />

                <span class="note">Insufficient balance. <a href="#">Add money & get rewarded</a></span>
            </label>

            <div class="add-code">
                <input type="text" placeholder="Enter Code">
                <button>Apply</button>
            </div>
        </div>

        <!-- Credit & Debit Cards -->
        <h3>Credit & Debit Cards</h3>
        <div class="container">
            <label class="payment-option disabled">
                <input type="radio" name="payment" disabled>
                Bank of Baroda Debit Card ending in 4375 <span class="card-type">VISA</span>
                <br />
                <span class="note">Card is no longer saved with us. <a href="#">Add again</a></span>
            </label>

            <label class="payment-option">
                <input type="radio" name="payment">
                Axis Bank Credit Card ending in 1712 <span class="card-type">VISA</span>
                @* <button class="pay-btn">Pay in Full ▼</button> *@
            </label>
        </div>
        <br />

        <h3>UPI</h3>
        <label class="payment-option" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
            <input  type="radio" name="payment">
            
            Google Pay
        </label>
        
    </div>

    <!-- Order Summary -->
    <div class="order-summary">
        <button class="order-btn">Use this payment method</button>
        <p>Items: --</p>
        <p>Delivery: --</p>
        <h3>Order Total: --</h3>
    </div>
</div>


<div class="modal fade" id="staticBackdrop" tabindex="-1" aria-labelledby="buyNowModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="buyNowModalLabel">UPI APPS</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="col mb-3">
                    <label class="form-label" style="color:black;">Enter Your UPI ID</label>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <input type="text" class="form-control w-100" id="email" placeholder="UPI ID" name="upiid" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <button type="submit" class="btn btn-outline-warning">Verify</button>
                        </div>
                    </div>
                    
                    
                    <span>The UPI ID  is in the format of name/phone number@bankname</span>
                </div>
                
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
               
            </div>

        </div>
    </div>
</div>

