@{
}
@model List<_06032025_MVCDAY1.Models.Product>

<h2>My Wishlist</h2>
<div>
    @if (!string.IsNullOrEmpty(Context.Session.GetString("email")))
    {
        <a>HELLO,@Context.Session.GetString("user_id")</a>
    }
    else
    {
        <a aria-current="page" asp-area="" asp-controller="User" asp-action="SignIn">HELLO, LOG IN</a>
    }
</div>
<div>
    @if (Model != null && Model.Any()) // Check if Model is not null and has data
    {
    @foreach (var product in Model)
    {
        <div class="product-card">
            <img src="@product.ProductImages" alt="no Image" />
            <h3>@product.product_name</h3>
            <p>₹ @product.price</p>

            <form action="@Url.Action("RemoveFromWishlist", "Wishlist")" method="post">
                <input type="hidden" name="product_id" value="@product.product_id" />
                <button type="submit">❌ Remove</button>
            </form>
        </div>
    }
    }
    else
    {
        <p>Your wishlist is empty.</p>
    }
</div>