@model _06032025_MVCDAY1.Models.OTPModel
@{

    Layout = null;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link href="~/css/site.css" rel="stylesheet" />

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-lg p-4" style="width: 450px; border-radius: 10px;">
        <h3 class="text-center mb-4" style="font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;">
            DealBazar
        </h3>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <!-- Send Email Form -->
        <div class="modal-body">

            <div id="alert-box" style="display: none;">
                <div class="alert alert-success" id="success-msg" style="display: none;"></div>
                <div class="alert alert-danger" id="error-msg" style="display: none;"></div>
            </div>

            <!-- Send Email Form -->
            <div id="email-section">
                <form id="send-otp-form">
                    <div class="mb-3">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <label for="email" class="form-label">Email address</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Send OTP</button>
                </form>
            </div>

            <!-- Verify OTP Form -->
            <div id="otp-section" style="display: none;">
                <form id="verify-otp-form">
                    <input type="hidden" name="Email" id="otp-email" />
                    <div class="mb-3">
                        <label>Enter OTP</label>
                        <input type="text" name="otp" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success">Verify</button>
                </form>

                <button id="resend-otp" class="btn btn-link mt-2">Resend OTP</button>
            </div>

        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        //Send OTP via AJAX
        $('#send-otp-form').submit(function (e) {
            e.preventDefault();
            var formData = $(this).serialize();

            $.post('/User/EmailVerifyForPass', formData, function (response) {
                if (response.success) {
                    $('#otp-email').val(response.email);
                    $('#email-section').hide();
                    $('#otp-section').show();
                    $('#success-msg').text(response.message).show();
                    $('#error-msg').hide();
                    $('#alert-box').show();
                } else {
                    $('#error-msg').text(response.message).show();
                    $('#success-msg').hide();
                    $('#alert-box').show();
                }
            });
        });

        // Verify OTP
               $('#verify-otp-form').submit(function (e) {
        e.preventDefault();
        var formData = $(this).serialize();

        $.post('/User/VerifyOTPForPass', formData, function (response) {
            if (response.success) {
                $('#success-msg').text(response.message).show();
                $('#error-msg').hide();
                $('#alert-box').show();

                // ✅ Redirect after short delay
                setTimeout(function () {
                    window.location.href = response.redirectUrl;
                }, 500); // 1.5 sec delay for user to read message
            } else {
                $('#error-msg').text(response.message).show();
                $('#success-msg').hide();
                $('#alert-box').show();
            }
        });
    });

        // Resend OTP
        $('#resend-otp').click(function () {
            var email = $('#otp-email').val();
            $.post('/User/EmailVerifyForPass', { Email: email }, function (response) {
                if (response.success) {
                    $('#success-msg').text('OTP resent successfully.').show();
                    $('#error-msg').hide();
                } else {
                    $('#error-msg').text('Failed to resend OTP.').show();
                    $('#success-msg').hide();
                }
                $('#alert-box').show();
            });
        });
    });
</script>