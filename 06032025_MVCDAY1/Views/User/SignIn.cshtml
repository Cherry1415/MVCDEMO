<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f7f7f7;
        display: flex;
        justify-content: center;
        align-items: top;
        height: 100vh;
        margin: 0;
    }

    .login-container {
        text-align: center;
    }

    .logo {
        width: 120px;
        margin-bottom: 15px;
    }

    .login-box {
        background: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        width: 320px;
    }

    h2 {
        font-size: 18px;
        margin-bottom: 10px;
    }

    .heading {
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        font-size: 40px;
    }

    label {
        display: block;
        font-size: 14px;
        text-align: left;
        margin: 10px 0 5px;
    }

    input {
        width: 100%;
        padding: 8px;
        border: 1px solid #a6a6a6;
        border-radius: 3px;
        font-size: 14px;
    }

    .continue-btn {
        width: 100%;
        background-color: aqua;
        border: none;
        padding: 10px;
        font-size: 16px;
        border-radius: 3px;
        margin-top: 15px;
        cursor: pointer;
    }

        .continue-btn:hover {
            background-color: #e6b800;
        }

    .terms, .business {
        font-size: 12px;
        text-align: left;
        margin-top: 15px;
        color: #555;
    }

        .terms a, .business a {
            color: #0066c0;
            text-decoration: none;
        }

            .terms a:hover, .business a:hover {
                text-decoration: underline;
            }
</style>
<div class="login-container">
    <h3 class="heading">DealBazar</h3>
    @* <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg" alt="Amazon Logo" class="logo"> *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
        @* <div class="alert alert-danger">@ViewBag.ErrorMessage</div> *@
    }
    <form asp-action="SignIn" method="post">
        <div class="login-box">
            <h2>Sign in account</h2>
            <label asp-for="email">Enter mobile number or email</label>
            <input type="text" id="email" asp-for="email" placeholder="">
            <label asp-for="password">Enter Password</label>
            <input type="password" id="password" asp-for="password" placeholder="">
            <button class="continue-btn" type="submit">Continue</button>
            <p class="terms">By continuing, you agree to DealBazar's <br /> <a href="#">Conditions of Use</a> and <a href="#">Privacy Notice</a>.</p>
            <hr />
            <p class="business">Buying for work?</p>
        </div>
    </form>
    
</div>