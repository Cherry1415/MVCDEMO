@model _06032025_MVCDAY1.Models.UserOrder

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-4">
                    <h3 class="text-center text-primary mb-4">Track Order #@Model.Id</h3>
                    <p class="text-center text-muted">
                        <strong>Customer:</strong> @Model.Customer_name<br />
                        <strong>Order Date:</strong> @Model.CreatedDate.ToString("dd-MMM-yyyy")<br />
                        @if (Model.delivered_date != null)
                        {
                            <strong>Estimated Delivery:</strong> @Model.delivered_date?.ToString("dd-MMM-yyyy")
                        }
                    </p>

                    @if (string.IsNullOrEmpty(Model.shipped_status))
                    {
                        <div class="alert alert-warning text-center">
                            <i class="bi bi-clock-history"></i> Supplier not assigned yet. Please wait while we process your order.
                        </div>

                        <ul class="timeline">
                            <li class="complete">
                                <span class="icon bg-primary"><i class="bi bi-cart-check-fill"></i></span>
                                <div class="details">
                                    <h6>Order Placed</h6>
                                    <small>@Model.CreatedDate.ToString("dd-MMM-yyyy")</small>
                                </div>
                            </li>
                            <li class="disabled">
                                <span class="icon bg-light text-muted"><i class="bi bi-person-gear"></i></span>
                                <div class="details">
                                    <h6>Waiting for Supplier</h6>
                                    <small>We will notify you once assigned.</small>
                                </div>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="timeline">
                            <li class="complete">
                                <span class="icon bg-success"><i class="bi bi-cart-check-fill"></i></span>
                                <div class="details">
                                    <h6>Order Placed</h6>
                                    <small>@Model.CreatedDate.ToString("dd-MMM-yyyy")</small>
                                </div>
                            </li>

                            <li class="complete">
                                <span class="icon bg-info"><i class="bi bi-person-gear"></i></span>
                                <div class="details">
                                    <h6>Supplier Assigned</h6>
                                    <small>Supplier accepted your order.</small>
                                </div>
                            </li>

                            @if (Model.shipped_status?.ToLower() == "rejected")
                            {
                                <li class="cancelled">
                                    <span class="icon bg-danger"><i class="bi bi-x-circle-fill"></i></span>
                                    <div class="details">
                                        <h6>Order Rejected</h6>
                                        <small>Supplier could not fulfill this order.</small>
                                    </div>
                                </li>
                            }
                            else if (Model.Status?.ToLower() == "delivered")
                            {
                                <li class="complete">
                                    <span class="icon bg-warning"><i class="bi bi-truck"></i></span>
                                    <div class="details">
                                        <h6>In Transit</h6>
                                        <small>Order shipped to your address.</small>
                                    </div>
                                </li>

                                <li class="complete">
                                    <span class="icon bg-success"><i class="bi bi-box-seam-fill"></i></span>
                                    <div class="details">
                                        <h6>Delivered</h6>
                                        <small>@Model.delivered_date?.ToString("dd-MMM-yyyy")</small>
                                    </div>
                                </li>
                            }
                            else if (Model.shipped_status?.ToLower() == "intransit")
                            {
                                <li class="complete">
                                    <span class="icon bg-warning"><i class="bi bi-truck"></i></span>
                                    <div class="details">
                                        <h6>In Transit</h6>
                                        <small>On the way to your address.</small>
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <span class="icon bg-secondary"><i class="bi bi-hourglass-split"></i></span>
                                    <div class="details">
                                        <h6>Processing</h6>
                                        <small>Your order is being prepared.</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .timeline {
        list-style: none;
        position: relative;
        padding-left: 30px;
        margin-top: 40px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            top: 0;
            left: 18px;
            width: 4px;
            height: 100%;
            background: #dee2e6;
        }

        .timeline li {
            margin-bottom: 30px;
            position: relative;
        }

            .timeline li:last-child {
                margin-bottom: 0;
            }

            .timeline li.complete::before {
                content: '';
                position: absolute;
                top: 35px;
                left: 18px;
                width: 4px;
                height: 100%;
                background: #28a745; /* Green for completed */
            }

            .timeline li.disabled::before {
                content: '';
                position: absolute;
                top: 0;
                left: 18px;
                width: 4px;
                height: 50%;
                background: #ccc;
            }

        .timeline .icon {
            position: absolute;
             left: 5px; 
            top: 5px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            z-index: 2;
        }

        .timeline li.cancelled .icon {
            background: #dc3545;
        }

        .timeline li .details {
            margin-left: 50px;
        }

            .timeline li .details h6 {
                margin: 0;
                font-weight: 600;
            }

            .timeline li .details small {
                color: #6c757d;
            }
</style>
